# --- HTTPS / mixed content ---
# Na produkci (https://xxrealit.cz / https://www.xxrealit.cz) musí být API i odkazy vždy https:// — jinak mixed content.
# `NEXT_PUBLIC_*` se inlinuje při `next build`; po změně env znovu sestavte frontend.

# Veřejná URL Nest API (včetně schématu https://). Bez koncového lomítka; přípona /api se doplní v kódu.
NEXT_PUBLIC_API_URL=https://your-nest-api.up.railway.app

# Kanonická URL webu — hlavní doména je www.
NEXT_PUBLIC_SITE_URL=https://www.xxrealit.cz

# Prioritní URL pro odkazy v e-mailech a reset hesla (server-side routes).
FRONTEND_URL=https://www.xxrealit.cz

# Alias pro odkazy v e-mailech / interní logice (volitelné).
# NEXT_PUBLIC_APP_URL=https://www.xxrealit.cz

# Diagnostika špatných redirectů v produkci (loguje Current Host / Redirect to v konzoli).
# NEXT_PUBLIC_DEBUG_SITE_ORIGIN=1

# Při NEXT_PUBLIC_DEBUG_API=1 vypíše konzole prohlížeče použitou API base (jen diagnostika).
# NEXT_PUBLIC_DEBUG_API=1
