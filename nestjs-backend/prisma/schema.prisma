  isTiparTip      Boolean  @default(false)
  /// Celkový počet zobrazení (real + manual + autopilot) — denormalizováno pro zpětnou kompatibilitu.
  viewsCount      Int      @default(0)
  /// Reálná zhlédnutí / zobrazení od návštěvníků.
  realViews       Int      @default(0)
  /// Ručně nastavený základ (dříve viewsCount).
  manualViews     Int      @default(0)
  /// Autopilotem přidaná zobrazení.
  autopilotViews  Int      @default(0)
  /// Autopilot zobrazení zapnutý u tohoto inzerátu.
  viewsAutopilotEnabled Boolean @default(true)
  viewsAutopilotRatePerHour Int?
  viewsAutopilotRateMin Int?
  viewsAutopilotRateMax Int?
  viewsAutopilotIntervalMinutes Int?
  viewsAutopilotMaxPerDay Int?
  viewsAutopilotMaxTotal Int?
  lastAutopilotViewsAt DateTime?
  autopilotViewsDayKey String @default("")
  autopilotViewsAddedToday Int @default(0)
