  @@unique([userId, propertyId])
  @@index([propertyId])
}

/// Lead zájemce po vyplnění formuláře před zobrazením kontaktu.
model ContactLead {
  id                 String    @id @default(cuid())
  listingId          String?
  tipId              String?
  sourceType         String    @default("LISTING")
  sourceId           String?
  leadSource         String?
  interestedUserId   String
  ownerUserId        String
  tipsterUserId      String?
  name               String
  email              String
  phone              String
  message            String?   @db.Text
  status             String    @default("UNLOCKED")
  unlockPrice        Int       @default(0)
  portalAmount       Int       @default(0)
  tipsterAmount      Int       @default(0)
  ownerChargedAmount Int       @default(0)
  creditCharged      Boolean   @default(false)
  unlockedAt         DateTime?
  createdAt          DateTime  @default(now())

