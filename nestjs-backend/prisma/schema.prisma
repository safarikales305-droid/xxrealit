  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiparPost TiparPost @relation(fields: [tiparPostId], references: [id], onDelete: Cascade)

  @@unique([userId, tiparPostId])
  @@index([tiparPostId])
}

/// Kreditní transakce (odemčení kontaktu tipaře).
model CreditTransaction {
  id                 String   @id @default(cuid())
