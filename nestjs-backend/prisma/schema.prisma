generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  AGENT
  COMPANY
  AGENCY
  FINANCIAL_ADVISOR
  INVESTOR
  DEVELOPER
  PRIVATE_SELLER
  CRAFTSMAN
  TIPSTER
  ADMIN
  PORTAL_WORKER
  PROPERTY_SEEKER
}

enum CreditTopUpStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  REVERSED
}

enum PostCategory {
  MAKLERI
  STAVEBNI_FIRMY
  REALITNI_KANCELARE
  FINANCNI_PORADCI
  INVESTORI
  REMESLNICI
}

enum AgentVerificationStatus {
  pending
  verified
  rejected
}

enum ProfessionalVerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum PortalWorkerStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  COOPERATION_CANCEL_REQUESTED
}

enum WorkerInternalMessageSender {
  ADMIN
  WORKER
}

enum WorkerCooperationCancelStatus {
  PENDING
  CONFIRMED
  RESTORED
}

enum WorkerRecruitmentTargetType {
  AGENT
  REAL_ESTATE_AGENCY
  CONSTRUCTION_COMPANY
  INVESTOR
  FINANCIAL_ADVISOR
  CRAFTSMAN
  TIPSTER
  PRIVATE_SELLER
  DEVELOPER
}

enum ClientPreregistrationStatus {
  PENDING
  COMPLETED
  EXPIRED
  NEEDS_CONTACT
}

enum WorkerClientNoteType {
  PHONE_CALL
  WHATSAPP
  EMAIL
  AGREED
  UNREACHABLE
  INTEREST
  REJECTED
  OTHER
}

enum WorkerClientAuditAction {
  CLIENT_CREATED
  WHATSAPP_SENT
  EMAIL_SENT
  REGISTRATION_COMPLETED
  BONUS_GRANTED
  CREDIT_TOPUP
  COMMISSION_CREATED
  STATUS_CHANGED
  NOTE_ADDED
  REMINDER_SENT
}

enum WorkerCommissionStatus {
  PENDING
  APPROVED
  PAID
}

enum TiparPayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum PostSource {
  INTERNAL
  FACEBOOK
}

enum FacebookImportStatus {
  IDLE
  RUNNING
  OK
  ERROR
}

enum FacebookPostType {
  FACEBOOK_POST
  FACEBOOK_VIDEO
  FACEBOOK_REEL
}

enum SocialPublishKind {
  PHOTO_POST
  VIDEO_REEL
  USER_POST
  LISTING
}

enum StoryType {
  IMAGE
  VIDEO
}

enum ShortsListingStatus {
  draft
  ready
  published
}

/// Stav posledního pokusu o vygenerování shorts videa (nezasahuje do ShortsListingStatus).
enum ShortsVideoRenderStatus {
  idle
  rendering
  failed
}

enum EmailLogStatus {
  queued
  sent
  failed
}

enum EmailCampaignStatus {
  draft
  scheduled
  running
  paused
  completed
  sent
  failed
}

enum EmailCampaignRecipientStatus {
  pending
  sent
  opened
  clicked
  registered
  unsubscribed
  failed
  skipped
}

enum EmailCampaignRecipientSource {
  imported_broker
  portal_user
}

enum ListingImportMethod {
  soap
  scraper
  apify
  xml
  csv
  other
}

enum ListingImportPortal {
  reality_cz
  century21_cz
  apify
  xml_feed
  csv_feed
  other
}

/// Z čeho lze u inzerátu skládat shorts (video / fotky / nic).
enum PropertyShortsSourceType {
  video
  images
  none
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String     @default("")
  phone        String     @default("")
  phonePublic  Boolean    @default(false)
  password     String
  role         UserRole   @default(USER)
  /// Public profile image URL (absolute or same-origin path).
  avatar       String?
  /// Volitelné UI nastavení výřezu profilové fotky (x/y posun, zoom).
  avatarCrop   Json?
  /// Široký cover obrázek profilu (URL).
  coverImage   String?
  /// Volitelné UI nastavení výřezu cover fotky (x/y posun, zoom).
  coverCrop    Json?
  bio          String?
  /// Veřejná webová stránka / URL profilu.
  website      String   @default("")
  /// Popis činnosti (veřejný profil).
  activityDescription String? @db.Text
  /// User's own city (for personalization); separate from listing city.
  city         String?
  /// Ulice a číslo popisné (profil / ověření).
  address      String   @default("")
  /// PSČ.
  postalCode   String   @default("")
  /// Křestní jméno (profil).
  firstName    String   @default("")
  /// Příjmení (profil).
  lastName     String   @default("")
  /// IČO na úrovni uživatele (sync s role profily); prázdné = null.
  profileIco   String?  @unique
  /// Average rating 0–5 (manual / future reviews).
  rating       Float      @default(0)
  creditBalance Int       @default(0)
  /// Běžný kredit (dobití po potvrzení, výplaty tipařům apod.).
  realCreditBalance Int   @default(0)
  /// Bonusový kredit — jen na kontakty klasických inzerátů.
  bonusCreditBalance Int  @default(0)
  /// Dočasný kredit z QR dobití před potvrzením adminem.
  pendingCreditBalance Int @default(0)
  /// Dluh po neuhrazeném / zrušeném dobití kreditu (když uživatel kredit mezitím utratil).
  creditDebt    Int       @default(0)
  /// Omezený účet kvůli neuhrazenému dobití kreditu.
  accountLimited Boolean  @default(false)
  /// Admin ověřil uživatele pro opakované dobití kreditu.
  isCreditVerified Boolean @default(false)
  /// Uživatel využil první QR dobití (neověřený limit).
  firstTopUpUsed Boolean @default(false)
  /// Uživatel vložil první inzerát nebo tip (onboarding po registraci).
  firstContentCompleted Boolean @default(false)
  /// Ověřený e-mail (povinný krok registrace).
  emailVerified Boolean @default(false)
  emailVerifiedAt DateTime?
  profileOnboardingEmailSentAt DateTime?
  emailVerificationToken String?
  emailVerificationExpires DateTime?
  /// Ověřený telefon (povinný krok registrace).
  phoneVerified Boolean @default(false)
  /// Unikátní referral kód pro pozvánky přátel.
  referralCode String? @unique
  /// Kdo uživatele pozval (referral).
  referredByUserId String?
  referredBy User? @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals User[] @relation("UserReferrals")
  /// Trvalé přiřazení k pracovníkovi portálu (doporučený klient).
  portalWorkerId String?
  portalWorker User? @relation("PortalWorkerClients", fields: [portalWorkerId], references: [id], onDelete: SetNull)
  portalWorkerClients User[] @relation("PortalWorkerClients")
  /// Stav schválení pro roli PORTAL_WORKER.
  portalWorkerStatus PortalWorkerStatus?
  portalWorkerApprovedAt DateTime?
  portalWorkerRejectedAt DateTime?
  portalWorkerSuspendedAt DateTime?
  /// Aktivní role tipaře — může vytvářet tipy na nemovitosti.
  isTipar       Boolean   @default(false)
  createdAt    DateTime   @default(now())
  resetToken   String?
  resetExpires DateTime?
  /// Facebook user id pro přihlášení / registraci přes Facebook.
  facebookId   String?    @unique

  properties   Property[]
  videos       Video[]
  posts        Post[]
  postReactions PostReaction[]
  postFavorites Favorite[]
  postComments  Comment[]
  likes        PropertyLike[]
  listingViews ListingView[]
  comments     PropertyComment[]

  following    Follow[]   @relation("UserFollowing")
  followers    Follow[]   @relation("UserFollowers")

  conversationsLow  PropertyConversation[] @relation("ConvUserLow")
  conversationsHigh PropertyConversation[] @relation("ConvUserHigh")
  propertyMessagesSent PropertyMessage[]   @relation("PropertyMessageSender")

  shortsMusicTracksUploaded ShortsMusicTrack[]
  companyAds CompanyAd[]

  /// Placený / aktivní „Premium makléř“ — notifikace na vlastnické inzeráty, kontakt při souhlasu.
  isPremiumBroker                  Boolean  @default(false)
  /// Zapnout/vypnout notifikace o nových vlastnických inzerátech (jen AGENT + isPremiumBroker).
  brokerLeadNotificationEnabled    Boolean  @default(true)
  /// Filtr krajů / oblastí (řetězce, case-insensitive match proti Property.region nebo city).
  brokerPreferredRegions           String[] @default([])
  brokerPreferredPropertyTypes     String[] @default([])
  brokerPoints                     Int      @default(0)
  /// Odměnové leady z gamifikace (kontaktování vlastnických inzerátů bez premium).
  brokerFreeLeads                  Int      @default(0)

  /// Admin schválil profesní profil (makléř / firma / poradce / investor).
  professionalVerified                 Boolean                      @default(false)
  professionalVerificationStatus       ProfessionalVerificationStatus @default(NONE)
  /// Veřejný profesní profil v katalogu Profesionálové / Makléři (jen po schválení).
  publicProfessionalProfile            Boolean                      @default(false)
  professionalVerificationRequestedAt  DateTime?
  professionalVerifiedAt               DateTime?
  professionalRejectedAt               DateTime?

  /// Veřejná stránka makléře v katalogu /makleri.
  isPublicBrokerProfile Boolean  @default(false)
  /// Jednotný přepínač veřejného profilu (příspěvky, feed, nastavení).
  publicProfile         Boolean  @default(false)
  /// Povolit publikování veřejných příspěvků ve feedu.
  canPublishPosts       Boolean  @default(false)
  /// Zobrazit v katalogu Profesionálové / profily (nezávisle na URL profilu).
  showInProfessionals   Boolean  @default(false)
  /// Zobrazit sekci hodnocení a přijímat nové recenze.
  allowBrokerReviews    Boolean  @default(false)
  /// Jedinečný slug pro URL /makler/[slug].
  brokerProfileSlug     String?  @unique
  brokerOfficeName      String   @default("")
  brokerSpecialization  String   @default("")
  brokerRegionLabel     String   @default("")
  brokerWeb             String   @default("")
  brokerPhonePublic     String   @default("")
  brokerEmailPublic     String   @default("")
  /// WhatsApp číslo ve formátu E.164 (+420…); veřejně se nezobrazuje, jen přes tlačítko wa.me.
  whatsappPhone         String   @default("")
  /// Telefon ověřený přes WhatsApp šablonu s kódem.
  whatsappVerified      Boolean  @default(false)
  whatsappVerifiedAt    DateTime?
  /// Ověřené WhatsApp číslo (unikátní napříč účty); null = neověřeno.
  whatsappVerifiedPhone String?  @unique
  /// Aktuální ověřovací kód (6 číslic); po ověření se vymaže.
  whatsappVerificationCode String?
  whatsappVerificationExpiresAt DateTime?
  /// Počet neúspěšných pokusů o zadání kódu (max 5).
  whatsappVerificationAttempts Int @default(0)
  /// Čas posledního odeslání ověřovacího kódu (cooldown 60 s).
  whatsappVerificationSentAt DateTime?
  /// Zobrazit tlačítko „Napsat na WhatsApp“ u profilu a inzerátů.
  whatsappEnabled       Boolean  @default(false)
  /// Uživatel odmítl marketing přes WhatsApp.
  whatsappMarketingOptOut    Boolean  @default(false)
  /// Čas udělení souhlasu s WhatsApp komunikací (registrace / explicitní souhlas).
  whatsappMarketingConsentAt DateTime?
  /// Marketingový souhlas — WhatsApp (registrace hledače nemovitosti).
  marketingConsentWhatsApp   Boolean  @default(false)
  /// Marketingový souhlas — e-mail (registrace hledače nemovitosti).
  marketingConsentEmail      Boolean  @default(false)
  /// Čas udělení marketingového souhlasu.
  consentCreatedAt           DateTime?
  /// Zdroj souhlasu, např. REGISTRATION_PROPERTY_SEEKER.
  consentSource              String?
  /// Souhlas s obchodními podmínkami portálu.
  termsAccepted              Boolean   @default(false)
  termsAcceptedAt            DateTime?
  termsVersion               Int?
  termsIp                    String?
  termsUserAgent             String?   @db.VarChar(512)
  /// Počet sdílení portálu přes WhatsApp (hledač nemovitosti).
  shareCount                 Int      @default(0)
  /// Čas dokončení povinného sdílení (5×).
  shareCompletedAt           DateTime?
  /// Uživatel sdílel portál přes WhatsApp při registraci.
  invitedViaWhatsApp         Boolean  @default(false)
  /// WhatsApp upozornění po vlastním nahrání příspěvku.
  whatsappNotifyMyUploads    Boolean @default(false)
  /// WhatsApp upozornění na nové příspěvky sledovaných uživatelů.
  whatsappNotifyNewPosts     Boolean @default(false)
  /// Agregát z viditelných recenzí (přepočet při změně recenze).
  brokerReviewAverage   Float    @default(0)
  brokerReviewCount     Int      @default(0)

  /// Adminem vytvořený promo profil (zaplnění portálu).
  isPromoProfile     Boolean @default(false)
  /// Aktivní promo profil — neaktivní se veřejně nezobrazuje.
  promoProfileActive Boolean @default(true)
  promoFirstName     String  @default("")
  promoLastName      String  @default("")

  /// Testovací účet pro opakované QA (admin).
  isTestAccount            Boolean @default(false)
  /// Zobrazit testovací účet ve veřejných katalozích.
  testAccountPublicVisible Boolean @default(false)
  /// Výchozí stav po resetu (kredity, ověření, telefon…).
  testAccountConfig        Json?

  /// Veřejná URL Facebook stránky/profilu pro import bez Meta API.
  facebookUrl            String?
  facebookImportEnabled  Boolean              @default(false)
  facebookLastSyncAt     DateTime?
  facebookImportStatus   FacebookImportStatus @default(IDLE)
  facebookImportError    String?              @db.Text

  /// Číslo účtu pro výplatu provizí tipařům.
  tiparPayoutBankAccount String?
  /// Celkový výdělek z tipů (kumulativně).
  tiparLifetimeEarnings Int @default(0)
  /// Dostupný výdělek k výplatě (bez bonusového kreditu).
  tiparEarningsBalance Int @default(0)
  /// Již vyplacená částka z tipů.
  tiparPaidOutTotal Int @default(0)

  /// Upozornění — nové příspěvky ve feedu / od sledovaných.
  notifyNewPosts       Boolean @default(true)
  /// Upozornění — nové zprávy v chatu.
  notifyNewMessages    Boolean @default(true)
  /// WhatsApp upozornění (kontakty, kampaně).
  notifyWhatsAppAlerts Boolean @default(true)
  /// Web push / PWA push notifikace.
  notifyPwaPush        Boolean @default(false)

  notifications        UserNotification[]
  brokerPointsLedger   BrokerPointsLedger[]
  brokerLeadOffers     BrokerLeadOffer[] @relation("UserBrokerLeads")
  brokerReviewsReceived BrokerReview[] @relation("BrokerReviewsTarget")
  brokerReviewsWritten  BrokerReview[] @relation("BrokerReviewsAuthor")

  agentProfile AgentProfile?
  companyProfile CompanyProfile?
  agencyProfile AgencyProfile?
  financialAdvisorProfile FinancialAdvisorProfile?
  investorProfile InvestorProfile?
  stories Story[]

  shortsListings ShortsListing[] @relation("UserShortsListings")
  tiparPosts     TiparPost[]
  tiparPayoutRequests TiparPayoutRequest[] @relation("TiparPayoutUser")
  tiparPayoutsResolved TiparPayoutRequest[] @relation("TiparPayoutAdmin")
  contactUnlocks ContactUnlock[]
  listingContactUnlocks ListingContactUnlock[]
  contactLeadsAsInterested ContactLead[] @relation("ContactLeadInterested")
  contactLeadsAsOwner      ContactLead[] @relation("ContactLeadOwner")
  contactLeadsAsTipster    ContactLead[] @relation("ContactLeadTipster")
  creditTransactionsAsBuyer CreditTransaction[] @relation("CreditTransactionBuyer")
  creditTransactionsAsTipar CreditTransaction[] @relation("CreditTransactionTipar")
  creditLedgerEntries CreditLedger[]
  developerNotes      DeveloperNote[] @relation("DeveloperNoteAuthor")
  developerNotesUpdated DeveloperNote[] @relation("DeveloperNoteUpdatedBy")
  supportTickets      SupportTicket[] @relation("SupportTicketUser")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignee")
  verificationFilesUploaded VerificationFile[] @relation("VerificationFileUploader")
  workerRecruitmentAssignments WorkerRecruitmentAssignment[] @relation("WorkerRecruitmentAssignmentWorker")
  workerRecruitmentAssignmentsSent WorkerRecruitmentAssignment[] @relation("WorkerRecruitmentAssignmentAdmin")
  workerRecruitmentDeliveriesSent WorkerRecruitmentDelivery[] @relation("WorkerRecruitmentDeliveryAdmin")
  supportTicketMessages SupportTicketMessage[] @relation("SupportTicketMessageAuthor")
  marketingPopupViews     MarketingPopupUserView[]
  registrationGamificationLeads RegistrationGamificationLead[]
  analyticsSessions       AnalyticsSession[]
  portalTermsVersionsCreated PortalTermsVersion[] @relation("PortalTermsAuthor")
  creditTopUpTransactions CreditTopUpTransaction[]
  workerCommissionsAsWorker WorkerCommission[] @relation("WorkerCommissionWorker")
  workerCommissionsAsClient WorkerCommission[] @relation("WorkerCommissionClient")
  clientPreregistrationsCreated ClientPreregistration[] @relation("ClientPreregistrationWorker")
  clientPreregistrationCompleted ClientPreregistration? @relation("ClientPreregistrationCompletedUser")
  workerProfile WorkerProfile?
  workerInternalMessagesReceived WorkerInternalMessage[] @relation("WorkerInternalMessageWorker")
  workerInternalMessagesSent WorkerInternalMessage[] @relation("WorkerInternalMessageSender")
  workerBulkMessagesCreated WorkerBulkMessage[] @relation("WorkerBulkMessageCreator")
  workerBulkMessageRecipients WorkerBulkMessageRecipient[] @relation("WorkerBulkMessageRecipientWorker")
  workerProfileReminderSettings WorkerProfileReminderSettings?
  workerCooperationCancelRequest WorkerCooperationCancelRequest? @relation("WorkerCooperationCancelWorker")
  workerCooperationCancelsResolved WorkerCooperationCancelRequest[] @relation("WorkerCooperationCancelResolver")
  workerWorkGuides WorkerWorkGuide[] @relation("WorkerWorkGuideWorker")
  workerClientNotesAuthored WorkerClientNote[] @relation("WorkerClientNoteAuthor")
  workerClientAudits WorkerClientAuditLog[] @relation("WorkerClientAuditActor")
  bonusClaims         BonusClaim[]
  referralInvitesSent ReferralInvite[] @relation("ReferralInvitesSent")
  facebookConnection           FacebookConnection?
  facebookPagesUserAuth        FacebookPagesUserAuth?
  facebookPageConnections      FacebookPageConnection[]
  facebookSyncedPosts          FacebookSyncedPost[]
  facebookUrlImportLogs        FacebookUrlImportLog[]
  socialConnections            SocialConnection[]
  socialImportedPosts          SocialImportedPost[]
  socialFacebookOAuthSessions  SocialFacebookOAuthSession[]
  whatsappMessages             WhatsAppMessage[]
  whatsappMessagesSent         WhatsAppMessage[] @relation("WhatsAppSentBy")
  whatsappMarketingCampaignsCreated WhatsAppMarketingCampaign[]
  whatsappMarketingCampaignLogs    WhatsAppMarketingCampaignLog[]
  webPushSubscriptions             WebPushSubscription[]
  postSoundTracksUploaded          PostSoundTrack[]
  crmContacts                  CrmContact[]
  marketingCampaigns           MarketingCampaign[]
  activityLogs                 ActivityLog[] @relation("ActivityLogActor")
  activityLogsTargeted         ActivityLog[] @relation("ActivityLogTarget")
  socialPublishQueueItems      SocialPublishQueue[]
  socialPublishSchedulesCreated SocialPublishSchedule[] @relation("SocialPublishScheduleCreator")
  socialPublishLogsTriggered   SocialPublishLog[] @relation("SocialPublishLogTrigger")

  @@index([professionalVerificationStatus, professionalVerificationRequestedAt])
}

model Story {
  id           String    @id @default(cuid())
  userId       String
  type         StoryType
  mediaUrl     String
  thumbnailUrl String?
  isPublic     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt, isPublic])
  @@index([userId, createdAt])
}

model AgentProfile {
  id                   String                  @id @default(cuid())
  userId               String                  @unique
  fullName             String
  companyName          String
  phone                String
  phoneVerified        Boolean                 @default(false)
  website              String                  @default("")
  ico                  String                  @default("")
  city                 String
  bio                  String                  @db.Text
  avatarUrl            String?
  isPublic             Boolean                 @default(false)
  verificationStatus   AgentVerificationStatus @default(pending)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus, createdAt])
}

model CompanyProfile {
  id                 String                  @id @default(cuid())
  userId             String                  @unique
  companyName        String
  contactFullName    String
  phone              String
  email              String
  website            String                  @default("")
  ico                String                  @default("")
  city               String
  description        String                  @db.Text
  services           String                  @db.Text
  logoUrl            String?
  isPublic           Boolean                 @default(false)
  verificationStatus AgentVerificationStatus @default(pending)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus, createdAt])
}

model CompanyAd {
  id          String   @id @default(cuid())
  companyId   String
  imageUrl    String
  title       String
  description String   @db.Text
  ctaText     String
  targetUrl   String
  categories  String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company User @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
  @@index([isActive, updatedAt])
}

model EmailLog {
  id                String         @id @default(cuid())
  type              String
  templateKey       String?
  subject           String
  recipientEmail    String
  senderEmail       String?
  senderName        String?
  status            EmailLogStatus @default(queued)
  provider          String         @default("resend")
  providerMessageId String?
  errorMessage      String?
  payloadJson       Json?
  createdAt         DateTime       @default(now())
  sentAt            DateTime?

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([recipientEmail, createdAt])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  category    String   @default("system")
  subject     String
  htmlContent String   @db.Text
  textContent String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailCampaign {
  id                  String              @id @default(cuid())
  type                String
  title               String
  subject             String
  templateKey         String?
  htmlContent         String              @db.Text
  textContent         String              @default("") @db.Text
  status              EmailCampaignStatus @default(draft)
  audienceJson        Json?
  senderName          String              @default("")
  minDaysBetweenSends Int                 @default(7)
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  scheduledAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  sentAt              DateTime?
  pausedAt            DateTime?

  steps       EmailCampaignStep[]
  recipients  EmailCampaignRecipient[]
  campaignLogs EmailCampaignLog[]

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model EmailCampaignStep {
  id          String   @id @default(cuid())
  campaignId  String
  stepOrder   Int
  name        String   @default("")
  subject     String
  htmlContent String   @db.Text
  textContent String   @default("") @db.Text
  delayDays   Int      @default(0)
  delayHours  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  logs     EmailCampaignLog[]

  @@unique([campaignId, stepOrder])
  @@index([campaignId])
}

model EmailCampaignRecipient {
  id                   String                       @id @default(cuid())
  campaignId           String
  email                String
  fullName             String                       @default("")
  firstName            String                       @default("")
  company              String                       @default("")
  phone                String                       @default("")
  role                 String                       @default("")
  source               EmailCampaignRecipientSource
  sourceId             String?
  status               EmailCampaignRecipientStatus @default(pending)
  lastCompletedStepOrder Int                        @default(-1)
  nextStepAt           DateTime?
  lastSentAt           DateTime?
  registeredAt         DateTime?
  unsubscribedAt       DateTime?
  errorMessage         String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  logs     EmailCampaignLog[]

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([nextStepAt])
  @@index([email])
}

model EmailCampaignLog {
  id                String         @id @default(cuid())
  campaignId        String
