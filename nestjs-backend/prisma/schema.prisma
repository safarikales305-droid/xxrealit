  mode            String   @default("account")
  userAccessToken String   @db.Text
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([mode])
}

/// Importovaný příspěvek z Facebook stránky (deduplikace).
