  soundTrackId        String?
  soundTrack          ShortsMusicTrack? @relation(fields: [soundTrackId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       Media[]
  reactions   PostReaction[]
  favorites   Favorite[]
  comments    Comment[]
  whatsappMessages WhatsAppMessage[]
  /// Reálné like (sync s PostReaction LIKE).
  realLikes         Int      @default(0)
  /// Ručně nastavené like.
  manualLikes       Int      @default(0)
  /// Autopilot like.
  autopilotLikes    Int      @default(0)
  likesAutopilotEnabled Boolean @default(true)
  likesAutopilotRatePerHour Int?
  likesAutopilotMaxTotal Int?
  lastAutopilotLikesAt DateTime?
  autopilotLikesDayKey String @default("")
  autopilotLikesAddedToday Int @default(0)
  postSocialPublishes PostSocialPublish[]
  /// SEO slug: např. nazev-prispevku-abc12
  slug            String?  @unique
  seoTitle        String?
  seoDescription  String?  @db.Text
  /// Volitelná vazba na ubytování (tip / příspěvek k hotelu).
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: SetNull)
  companyDirectoryId String?
  companyDirectory   CompanyDirectoryEntry? @relation(fields: [companyDirectoryId], references: [id], onDelete: SetNull)
  companyReviewId    String? @unique
  companyReview      CompanyReview? @relation(fields: [companyReviewId], references: [id], onDelete: SetNull)
  newsArticleId      String? @unique
  newsArticle        NewsArticle? @relation(fields: [newsArticleId], references: [id], onDelete: SetNull)
  newsSourceId       String?
  newsSource         NewsSource? @relation(fields: [newsSourceId], references: [id], onDelete: SetNull)
  editorialSourceName String?
  editorialSourceUrl  String?
  editorialExternalId String?
  /// Poslední použití v automatické Facebook Reel kompilaci
  lastUsedInReelAt    DateTime?
  reelUsageCount      Int              @default(0)
  /// Skrytí z veřejného Shorts feedu (admin)
  hiddenFromShorts    Boolean          @default(false)
  /// Režim publikace YouTube/redakčního obsahu
  editorialContentMode EditorialContentMode @default(SHORTS_ONLY)
  seoQualityScore      Int              @default(0)
  isIndexable          Boolean          @default(false)
  robots               String?
  canonicalPath        String?
  editorialTopicCluster String?
  editorialLocation    String?
  editorialLocationConfidence Float?
  editorialH1          String?
  editorialPerex       String?          @db.Text
  editorialBodyMarkdown String?         @db.Text
  editorialSeoDiagnosticsJson Json?
  editorialRelatedPostIds String[]      @default([])
  editorialInternalLinksJson Json?
  duplicateTopicBlocked Boolean         @default(false)
  contentModeManual    Boolean          @default(false)
  indexableManual      Boolean          @default(false)
  editorialSchemaJson  Json?
  editorialOgImageUrl  String?
  reelSegments        EditorialReelSegment[]
  shortsCollectionItems ShortsCollectionItem[]
  aiInfluencerReelJobs AiInfluencerReelJob[]
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([slug])
  @@index([source, createdAt])
  @@index([facebookVideoId])
  @@index([source, lastMediaRefreshAt])
  @@index([latitude, longitude])
  @@index([soundTrackId])
  @@index([accommodationId])
}

