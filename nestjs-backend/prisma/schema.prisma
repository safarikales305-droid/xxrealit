  slug                  String   @default("o-portalu")
  isPublished           Boolean  @default(false)
  metaTitle             String
  metaDescription       String   @db.Text
  metaKeywords          String?  @db.Text
  ogImageUrl            String?
  canonicalUrl          String?
  heroTitle             String
  heroSubtitle          String   @db.Text
  heroBadgeText         String?  @default("Představení portálu")
  faqTitle              String?  @default("Časté dotazy")
  heroCtaLabel          String?
  heroCtaUrl            String?
  heroSecondaryCtaLabel String?
  heroSecondaryCtaUrl   String?
  heroImageUrl          String?
  heroVideoUrl          String?
  heroGradientFrom      String   @default("#ff6a00")
  heroGradientTo        String   @default("#ff3c00")
  contactEmail          String?
  contactPhone          String?
  contactAddress        String?  @db.Text
  publishedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sections   PortalPresentationSection[]
  faqItems   PortalPresentationFaq[]
  analytics  PortalPresentationAnalytics[]

  @@unique([locale, slug])
  @@index([isPublished, locale])
}

model PortalPresentationSection {
  id          String   @id @default(cuid())
  pageId      String
  page        PortalPresentationPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  anchor      String
  sectionType String   @default("feature")
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  icon        String?
  title       String
  subtitle    String?  @db.Text
  bodyHtml    String   @db.Text
  imageUrl    String?
  galleryUrls String[] @default([])
  videoUrl    String?
  youtubeUrl  String?
  ctaLabel    String?
  ctaUrl      String?
  accentColor String?
  bgStyle     String   @default("white")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pageId, anchor])
  @@index([pageId, sortOrder])
}

model PortalPresentationFaq {
  id         String   @id @default(cuid())
  pageId     String
  page       PortalPresentationPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  question   String
  answerHtml String   @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([pageId, sortOrder])
}

model PortalPresentationAnalytics {
  id        String   @id @default(cuid())
  pageId    String
  page      PortalPresentationPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  eventType String
  visitorId String?
  sessionId String?
  payload   Json?
  referrer  String?
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now())

  @@index([pageId, eventType, createdAt])
  @@index([createdAt])
}

/// Interní vývojářské poznámky (admin).
model DeveloperNote {
  id          String   @id @default(cuid())
  category    String
  status      String   @default("OPEN")
  body        String   @db.Text
  authorId    String
  author      User     @relation("DeveloperNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  updatedById String?
  updatedBy   User?    @relation("DeveloperNoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([category])
  @@index([status])
  @@index([updatedById])
}

/// Předregistrace klienta vytvořená pracovníkem portálu (zahájená registrace / pozvánka).
model ClientPreregistration {
  id               String                      @id @default(cuid())
  workerId         String
  targetRole       UserRole
  name             String
  firstName        String                      @default("")
  lastName         String                      @default("")
  company          String                      @default("")
  email            String
  phone            String
  whatsappPhone    String                      @default("")
  ico              String                      @default("")
  city             String                      @default("")
  note             String?                     @db.Text
  status           ClientPreregistrationStatus @default(PENDING)
  completionToken  String                      @unique
  tokenExpiresAt   DateTime
  completedUserId  String?                     @unique
  reminder24hSentAt DateTime?
  reminder72hSentAt DateTime?
  lastWhatsappAt   DateTime?
  lastEmailAt      DateTime?
  lastActivityAt   DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  worker        User  @relation("ClientPreregistrationWorker", fields: [workerId], references: [id], onDelete: Cascade)
  completedUser User? @relation("ClientPreregistrationCompletedUser", fields: [completedUserId], references: [id], onDelete: SetNull)
  notes         WorkerClientNote[]
  auditLogs     WorkerClientAuditLog[]

  @@index([workerId, createdAt])
  @@index([email])
  @@index([phone])
  @@index([whatsappPhone])
  @@index([status])
}

/// Profil pracovníka portálu — provize, limity bonusů, admin poznámky.
model WorkerProfile {
  userId              String   @id
  commissionPercent   Int?
  maxBonusPerClient   Int      @default(3000)
  adminNotes          String?  @db.Text
  permissions         Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Poznámka pracovníka ke klientovi (předregistrace nebo dokončený účet).
model WorkerClientNote {
  id                String               @id @default(cuid())
  workerId          String
  preregistrationId String?
  clientUserId      String?
  noteType          WorkerClientNoteType @default(OTHER)
  body              String               @db.Text
  createdAt         DateTime             @default(now())

  worker          User                  @relation("WorkerClientNoteAuthor", fields: [workerId], references: [id], onDelete: Cascade)
  preregistration ClientPreregistration? @relation(fields: [preregistrationId], references: [id], onDelete: Cascade)

  @@index([workerId, createdAt])
  @@index([preregistrationId])
  @@index([clientUserId])
}

/// Auditní log CRM pracovníka portálu.
model WorkerClientAuditLog {
  id                String                  @id @default(cuid())
  workerId          String
  actorUserId       String
  preregistrationId String?
  clientUserId      String?
  action            WorkerClientAuditAction
  metadata          Json?
  createdAt         DateTime                @default(now())

  actor           User                   @relation("WorkerClientAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  preregistration ClientPreregistration? @relation(fields: [preregistrationId], references: [id], onDelete: SetNull)

  @@index([workerId, createdAt])
  @@index([preregistrationId])
  @@index([clientUserId])
  @@index([action])
}

/// Nastavení provizí pracovníků portálu (singleton).
model WorkerCommissionSetting {
  id                 String   @id @default("default")
  defaultPercent     Int      @default(10)
  defaultFixedAmount Int      @default(0)
  minTopUpAmount     Int      @default(300)
  validityDays       Int      @default(365)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Procento provize podle role doporučeného klienta.
model WorkerCommissionRoleRate {
  role         UserRole @id
  percent      Int
  fixedAmount  Int      @default(0)
}

/// Provize pracovníka z potvrzeného dobití kreditu klienta (jen placený kredit).
model WorkerCommission {
  id               String                 @id @default(cuid())
  workerId         String
  referredUserId   String
  creditTopUpId    String                 @unique
  amount           Int
  percent          Int
  commissionAmount Int
  status           WorkerCommissionStatus @default(PENDING)
  createdAt        DateTime               @default(now())
  paidAt           DateTime?

  worker       User                   @relation("WorkerCommissionWorker", fields: [workerId], references: [id], onDelete: Cascade)
  referredUser User                   @relation("WorkerCommissionClient", fields: [referredUserId], references: [id], onDelete: Cascade)
  creditTopUp  CreditTopUpTransaction @relation(fields: [creditTopUpId], references: [id], onDelete: Cascade)

  @@index([workerId, createdAt])
  @@index([referredUserId, createdAt])
  @@index([status])
}

enum SupportTicketStatus {
  NEW
  WAITING_REPLY
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  TECHNICAL
  LISTING
  PAYMENTS
  CREDITS
  BROKERS
  CONSTRUCTION
  INVESTORS
  FINANCIAL_ADVISORS
  REPORT_ISSUE
  BUSINESS_COOPERATION
  OTHER
}

enum SupportMessageAuthorType {
  CUSTOMER
  STAFF
  SYSTEM
}

/// Interní ticket zákaznické podpory portálu.
model SupportTicket {
  id               String               @id @default(cuid())
  publicId         String               @unique
  userId           String?
  firstName        String
  lastName         String?
  phone            String
  whatsapp         String
  email            String
  subject          String
  category         SupportTicketCategory
  status           SupportTicketStatus  @default(NEW)
  assignedToId     String?
  ipAddress        String?
  userAgent        String?              @db.VarChar(512)
  gdprConsentAt    DateTime
  contactConsentAt DateTime
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  lastMessageAt    DateTime             @default(now())

  user       User?                  @relation("SupportTicketUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo User?                  @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportTicketMessage[]

  @@index([status, createdAt])
  @@index([category])
  @@index([email])
  @@index([phone])
  @@index([whatsapp])
  @@index([assignedToId])
  @@index([userId, createdAt])
  @@index([publicId])
}

model SupportTicketMessage {
  id             String                 @id @default(cuid())
  ticketId       String
  authorType     SupportMessageAuthorType
  authorUserId   String?
  body           String                 @db.Text
  isInternalNote Boolean                @default(false)
  createdAt      DateTime               @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser User?         @relation("SupportTicketMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}
