/// Tipařský příspěvek — tip na nemovitost, volitelně ve Shorts feedu.
model TiparPost {
  id                  String    @id @default(cuid())
  userId              String
  title               String
  description         String    @db.Text
  images              String[]  @default([])
  /// Hlavní fotka (první v galerii) — denormalizace pro karty a detail.
  mainImage           String?
  videoUrl            String?
  /// Vygenerované Shorts video (náhled před publikováním / zdroj pro videoUrl).
  generatedVideoUrl   String?
  /// ID skladby z knihovny použité při generování Shorts.
  selectedMusicId     String?
  city                String    @default("")
  propertyPrice       Int?
  sourceUrl           String?
  ownerNote           String?   @db.Text
  contactName         String    @default("")
  contactPhone        String    @default("")
  contactEmail        String    @default("")
  contactUnlockPrice  Int       @default(100)
  isShorts            Boolean   @default(false)
  publishedPropertyId String?   @unique
  isActive            Boolean   @default(true)
  approved            Boolean   @default(true)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishedProperty Property?          @relation("TiparPublishedProperty", fields: [publishedPropertyId], references: [id], onDelete: SetNull)
  contactUnlocks    ContactUnlock[]
  creditTransactions CreditTransaction[]
  contactLeads      ContactLead[] @relation("ContactLeadTip")

  @@index([userId, createdAt])
  @@index([isShorts, isActive, approved])
  @@index([deletedAt])
