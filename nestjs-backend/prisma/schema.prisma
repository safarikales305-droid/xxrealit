  buyerUserId        String
  tiparUserId        String?
  tiparPostId        String?
  propertyId         String?
  amount             Int
  type               String   @default("CONTACT_UNLOCK")
  sourceType         String?
  sourceId           String?
  counterpartyUserId String?
  portalAmount       Int?
  tipsterAmount      Int?
  description        String?
  createdAt          DateTime @default(now())

  buyer     User       @relation("CreditTransactionBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  tipar     User?      @relation("CreditTransactionTipar", fields: [tiparUserId], references: [id], onDelete: Cascade)
  tiparPost TiparPost? @relation(fields: [tiparPostId], references: [id], onDelete: Cascade)
  property  Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)

