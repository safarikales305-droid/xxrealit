  mimeType          String
  content           String   @db.Text
  isActive          Boolean  @default(true)
  uploadedByAdminId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  uploadedBy User @relation("VerificationFileUploader", fields: [uploadedByAdminId], references: [id], onDelete: Cascade)

  @@index([filename, isActive])
}

