enum SocialProvider {
  FACEBOOK
}

/// Propojení Facebook stránky pro automatický import příspěvků.
model SocialConnection {
  id                   String         @id @default(cuid())
  userId               String
  provider             SocialProvider @default(FACEBOOK)
  facebookUserId       String?
  facebookName         String?
  facebookEmail        String?
  facebookPicture      String?
  pageId               String?
  pageName             String?
  pageAccessToken      String?        @db.Text
  tokenExpiresAt       DateTime?
  syncEnabled          Boolean        @default(true)
  lastSyncAt           DateTime?
  lastSyncError        String?        @db.Text
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  importedPosts  SocialImportedPost[]

  @@unique([userId, provider])
  @@index([provider, syncEnabled])
  @@index([pageId])
}

/// Dočasná OAuth session mezi callbackem a výběrem stránky / loginem.
model SocialFacebookOAuthSession {
  id              String   @id
  userId          String?
  /// login | page | account
  mode            String   @default("account")
  userAccessToken String   @db.Text
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([mode])
}

/// Importovaný příspěvek z Facebook stránky (deduplikace).
model SocialImportedPost {
  id              String         @id @default(cuid())
  userId          String
  connectionId    String
  provider        SocialProvider @default(FACEBOOK)
  providerPostId  String
  sourceUrl       String?
  message         String?        @db.Text
  imageUrl        String?
  videoUrl        String?
  importedPostId  String?
  createdAt       DateTime       @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPostId])
  @@index([connectionId, createdAt])
  @@index([userId])
}

/// Propojení uživatelského účtu s Facebookem (login + Graph API).
model FacebookConnection {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  facebookUserId         String
  accessToken            String    @db.Text
  accessTokenEncrypted   String?   @db.Text
  tokenExpiresAt         DateTime?
  scopes                 String[]  @default([])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([facebookUserId])
}

/// OAuth token z Meta Pages aplikace (odděleně od Facebook Login pro registraci).
model FacebookPagesUserAuth {
  id                   String    @id @default(cuid())
  userId               String    @unique
  facebookUserId       String
  accessTokenEncrypted String    @db.Text
  tokenExpiresAt       DateTime?
  scopes               String[]  @default([])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([facebookUserId])
}

/// Propojení Facebook stránky profesionála (správa + sync příspěvků).
model FacebookPageConnection {
  id                       String    @id @default(cuid())
  userId                   String
  pageId                   String
  pageName                 String
  pageAccessTokenEncrypted String    @db.Text
  pagePictureUrl           String?
  isActive                 Boolean   @default(true)
  lastSyncAt               DateTime?
  lastSyncError            String?   @db.Text
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncedPosts   FacebookSyncedPost[]

  @@unique([userId, pageId])
  @@index([userId])
  @@index([pageId])
  @@index([isActive])
}

/// Log běhu importu Facebook URL (admin + diagnostika).
model FacebookUrlImportLog {
  id        String   @id @default(cuid())
  userId    String
  status    String
  found            Int      @default(0)
  imported         Int      @default(0)
  skipped          Int      @default(0)
  importedCount    Int      @default(0)
  skippedDuplicates Int     @default(0)
  fetchUrl         String?
  httpStatus       Int?
  contentLength    Int?
  detectedReason   String?
  rawSnippet       String?  @db.Text
  error            String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Synchronizovaný příspěvek z Facebook stránky.
model FacebookSyncedPost {
  id               String    @id @default(cuid())
  userId           String
  pageConnectionId String
  facebookPostId   String    @unique
  message          String?   @db.Text
  story            String?
  permalinkUrl     String?
  fullPictureUrl   String?
  videoSourceUrl   String?
  videoUrlFailureReason String? @db.Text
  videoHasAudio    Boolean?
  videoMimeType    String?
  createdTime      DateTime?
  rawJson          Json?
  importedPostId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageConnection FacebookPageConnection @relation(fields: [pageConnectionId], references: [id], onDelete: Cascade)

  @@index([pageConnectionId, createdAt])
  @@index([userId])
}

/// Historie bodů + idempotence (dedupeKey).
model BrokerPointsLedger {
  id        String   @id @default(cuid())
  userId    String
  action    String
  points    Int
  dedupeKey String
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

enum WhatsAppMarketingCampaignType {
  NEW_LISTINGS
  BONUS_CREDITS
  INTERESTING_TIPS
  PORTAL_INVITE
  AGENT_AD
  INVESTOR_PROMO
  CUSTOM
}

enum WhatsAppMarketingCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  PARTIAL_FAILED
  CANCELLED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  WA_ME_CLICK
  RECEIVED
}

/// Zprávy a leady přes WhatsApp (wa.me kliknutí i Cloud API).
model WhatsAppMessage {
  id                String                   @id @default(uuid())
  userId            String?
  sentByUserId      String?
  listingId         String?
  recipientName     String?
  direction         WhatsAppMessageDirection
  fromPhone         String                   @default("")
  toPhone           String                   @default("")
  message           String                   @default("") @db.Text
  status            WhatsAppMessageStatus    @default(PENDING)
  providerMessageId String?
  /// Související příspěvek (upozornění po uploadu / nový příspěvek).
  postId            String?
  /// POST_UPLOADED_AUTHOR | NEW_POST_NOTIFICATION
  notificationType  String?
  errorMessage      String?                  @db.Text
  createdAt         DateTime                 @default(now())

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  sentByUser User?     @relation("WhatsAppSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  listing    Property? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  post       Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sentByUserId, createdAt])
  @@index([listingId, createdAt])
  @@index([postId])
  @@index([notificationType])
  @@index([status, createdAt])
  @@index([providerMessageId])
}

/// Admin WhatsApp marketingová kampaň.
model WhatsAppMarketingCampaign {
  id              String                          @id @default(cuid())
  name            String
  campaignType    WhatsAppMarketingCampaignType
  messageTemplate String                          @db.Text
  /// Schválený název šablony v Meta Business Manageru (povinné pro odeslání).
  waTemplateName      String                      @default("")
  /// ID synchronizované šablony z Meta (WhatsAppMetaTemplate.id).
  waMetaTemplateId    String?
  /// Jazyk šablony (cs, cs_CZ, en_US, …).
  waTemplateLanguage  String                      @default("cs")
  /// Hodnoty proměnných šablony v pořadí {{1}}, {{2}}, … — podporují {jmeno}, {role}, {odkaz}, {kredit}.
  waTemplateVariables String[]                    @default([])
  /// Veřejná HTTPS URL obrázku pro HEADER IMAGE šablony.
  waHeaderImageUrl      String?
  /// Meta media_id (alternativa k URL) pro HEADER IMAGE.
  waHeaderImageMediaId  String?
  /// Dynamický parametr URL tlačítka šablony (koncová část odkazu).
  waUrlButtonParameter  String?
  targetRoles     UserRole[]                      @default([])
  targetRegions   String[]                        @default([])
  targetCities    String[]                        @default([])
  manualPhones    String[]                        @default([])
  status          WhatsAppMarketingCampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  lastError       String?                         @db.Text
  createdByUserId String?
  recipientCount  Int                             @default(0)
  sentCount       Int                             @default(0)
  failedCount     Int                             @default(0)
  skippedCount    Int                             @default(0)
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  sentAt          DateTime?

  createdBy User?                          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  logs      WhatsAppMarketingCampaignLog[]

  @@index([status, createdAt])
  @@index([status, scheduledAt])
  @@index([createdByUserId])
}

/// Schválené WhatsApp šablony synchronizované z Meta Graph API.
model WhatsAppMetaTemplate {
  id               String    @id @default(cuid())
  wabaId           String?
  metaTemplateId   String    @unique
  templateName     String
  category         String
  language         String
  status           String
  rawStatus        String?
  normalizedStatus String?
  rawTemplate      Json?
  usable           Boolean   @default(false)
  headerType       String    @default("NONE")
  /// Počet URL tlačítek s dynamickým parametrem v šabloně.
  urlButtonParamCount Int    @default(0)
  bodyText         String    @db.Text
  variablesCount   Int       @default(0)
  isStale          Boolean   @default(false)
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([wabaId, templateName, language])
  @@index([status])
  @@index([normalizedStatus])
  @@index([usable])
  @@index([isStale])
  @@index([wabaId])
  @@index([templateName, language])
}

/// Historie odeslání WhatsApp marketingu (kampaně i uvítací zprávy).
model WhatsAppMarketingCampaignLog {
  id              String                           @id @default(cuid())
  campaignId      String?
  recipientUserId String?
  recipientName   String?
  recipientPhone  String
  campaignType    WhatsAppMarketingCampaignType?
  message         String                           @db.Text
  status          WhatsAppMessageStatus
  errorMessage    String?                          @db.Text
  providerMessageId String?
  isWelcome       Boolean                          @default(false)
  createdAt       DateTime                         @default(now())

  campaign  WhatsAppMarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipient User?                      @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@index([recipientPhone, createdAt])
  @@index([createdAt])
}

/// První „lead“ makléře k vlastnickému inzerátu (statistiky, spotřeba free leadu).
model BrokerLeadOffer {
  id           String   @id @default(cuid())
  brokerId     String
  propertyId   String
  usedFreeLead Boolean  @default(false)
  createdAt    DateTime @default(now())

  broker   User     @relation("UserBrokerLeads", fields: [brokerId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([brokerId, propertyId])
  @@index([propertyId])
  @@index([brokerId])
}

/// Hodnocení makléře (jen AGENT jako brokerId).
model BrokerReview {
  id         String   @id @default(cuid())
  brokerId   String
  authorId   String
  rating     Int
  reviewText String   @db.Text
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
