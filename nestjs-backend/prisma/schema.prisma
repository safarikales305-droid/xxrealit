  locale                String   @default("cs")
  slug                  String   @default("o-portalu")
  isPublished           Boolean  @default(false)
  metaTitle             String
  metaDescription       String   @db.Text
  metaKeywords          String?  @db.Text
  ogImageUrl            String?
  canonicalUrl          String?
  heroTitle             String
  heroSubtitle          String   @db.Text
  heroBadgeText         String?  @default("Představení portálu")
  faqTitle              String?  @default("Časté dotazy")
  heroCtaLabel          String?
  heroCtaUrl            String?
  heroSecondaryCtaLabel String?
  heroSecondaryCtaUrl   String?
  heroImageUrl          String?
  heroVideoUrl          String?
