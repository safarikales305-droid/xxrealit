  userId      String
  tiparPostId String
  amount      Int
  unlockedAt  DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiparPost TiparPost @relation(fields: [tiparPostId], references: [id], onDelete: Cascade)

