  galleryUrls String[] @default([])
  videoUrl    String?
  youtubeUrl  String?
  ctaLabel    String?
  ctaUrl      String?
  accentColor String?
  bgStyle     String   @default("white")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pageId, anchor])
  @@index([pageId, sortOrder])
}

model PortalPresentationFaq {
  id         String   @id @default(cuid())
  pageId     String
  page       PortalPresentationPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  question   String
  answerHtml String   @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([pageId, sortOrder])
}

model PortalPresentationAnalytics {
  id        String   @id @default(cuid())
  pageId    String
  page      PortalPresentationPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  eventType String
  visitorId String?
  sessionId String?
  payload   Json?
  referrer  String?
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now())

  @@index([pageId, eventType, createdAt])
  @@index([createdAt])
}

/// Interní vývojářské poznámky (admin).
model DeveloperNote {
  id          String   @id @default(cuid())
  category    String
  status      String   @default("OPEN")
  body        String   @db.Text
  authorId    String
  author      User     @relation("DeveloperNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  updatedById String?
  updatedBy   User?    @relation("DeveloperNoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([category])
  @@index([status])
  @@index([updatedById])
}

/// Předregistrace klienta vytvořená pracovníkem portálu (zahájená registrace / pozvánka).
model ClientPreregistration {
  id               String                      @id @default(cuid())
  workerId         String
  targetRole       UserRole
  name             String
  firstName        String                      @default("")
  lastName         String                      @default("")
  company          String                      @default("")
  email            String
  phone            String
  whatsappPhone    String                      @default("")
  ico              String                      @default("")
  city             String                      @default("")
  address          String                      @default("")
  website          String                      @default("")
  activityDescription String?                  @db.Text
  bio              String?                     @db.Text
  note             String?                     @db.Text
  workerInternalNote String?                   @db.Text
  status           ClientPreregistrationStatus @default(PENDING)
  completionToken  String                      @unique
  tokenExpiresAt   DateTime
  completedUserId  String?                     @unique
  reminder24hSentAt DateTime?
  reminder72hSentAt DateTime?
  lastWhatsappAt   DateTime?
  lastEmailAt      DateTime?
  lastActivityAt   DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

