// ─── Realitní aktuality / AI redakce ─────────────────────────────────────────

enum NewsSourceType {
  RSS
  ATOM
  API
  OPEN_DATA
  WEB_SOURCE
  YOUTUBE_CHANNEL
}

enum NewsYoutubePublishMode {
  RELEVANT_ONLY
  ALL
}

enum NewsSourceItemStatus {
  NEW
  ANALYZED
  IGNORED
  DUPLICATE
  MERGED
  ERROR
}

enum NewsEditorialDecision {
  IGNORE
  WATCH
  CREATE_DRAFT
  HIGH_PRIORITY
}

enum NewsArticleStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum NewsPublishMode {
  MANUAL
  AFTER_APPROVAL
  AUTOMATIC
}

enum NewsWorkerJobType {
  SOURCE_FETCH
  NEWS_ANALYSIS
  ARTICLE_GENERATION
  ARTICLE_QA
  PUBLISH
  SOCIAL_PUBLISH
}

enum NewsWorkerJobStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum NewsSourceHealth {
  ACTIVE
  DEGRADED
  ERROR
  DISABLED
}

model NewsSource {
  id                   String           @id @default(cuid())
  name                 String
  url                  String
  type                 NewsSourceType
  category             String?
  enabled              Boolean          @default(true)
  trustScore           Int              @default(80)
  priority             Int              @default(50)
  language             String           @default("cs")
  checkIntervalMinutes Int              @default(30)
  note                 String?          @db.Text
  health               NewsSourceHealth @default(ACTIVE)
  lastCheckedAt        DateTime?
  lastSuccessAt        DateTime?
  lastHttpStatus       Int?
  lastItemCount        Int?
  lastContentType      String?
  lastError            String?          @db.Text
  itemsFoundTotal      Int              @default(0)
  failureCount         Int              @default(0)
  /// YouTube: kanálové ID (UC…)
  channelId            String?
  /// YouTube: uploads playlist ID (UU…) pro efektivní sync
  uploadsPlaylistId    String?
  /// YouTube: název kanálu z API
  youtubeChannelTitle  String?
  youtubePublishMode   NewsYoutubePublishMode @default(RELEVANT_ONLY)
  youtubeCreatePost    Boolean          @default(true)
  youtubeFacebookPost  Boolean          @default(false)
  minRelevanceScore    Int?
  lastVideoPublishedAt DateTime?
  lastVideoId          String?
  youtubeImportedCount Int              @default(0)
  /// Spravovaná kategorie zdroje (YouTube / RSS)
  contentCategoryId    String?
  contentCategory      ContentSourceCategory? @relation(fields: [contentCategoryId], references: [id], onDelete: SetNull)
  /// Automaticky kontrolovat nová videa (nezávisle na enabled)
  youtubeAutoImport    Boolean          @default(true)
  /// Automaticky publikovat importovaná videa do Shorts
  youtubePublishToShorts Boolean        @default(true)
  /// Zařadit nová videa do Facebook Reel kompilací
  youtubeUseForReel    Boolean          @default(true)
  lastAutoImportedAt   DateTime?
  lastPublishedToShortsAt DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  items                NewsSourceItem[]
  posts                Post[]
  @@unique([url])
  @@index([enabled, priority])
}

model NewsTopic {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  summary             String?  @db.Text
  trendScore          Int      @default(0)
  mergedSourceItemIds String[] @default([])
  status              String   @default("OPEN")
  region              String?
  category            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  sourceItems         NewsSourceItem[]
  article             NewsArticle?
  @@index([status, trendScore])
}

model NewsArticle {
  id                 String            @id @default(cuid())
  slug               String            @unique
  title              String
  seoTitle           String
  seoDescription     String            @db.Text
  perex              String            @db.Text
  bodyMarkdown       String            @db.Text
  bodyHtml           String?           @db.Text
  canonicalPath      String?
  ogImageUrl         String?
  ogImageAlt         String?
  imageDiagnosticsJson Json?
  category           String            @default("reality")
  region             String?
  status             NewsArticleStatus @default(DRAFT)
  qualityScore       Int?
  relevanceScore     Int?
  languageQualityScore Int?
  seoScore           Int?
  waitReason         String?
  publishMode        NewsPublishMode?
  scheduledAt        DateTime?
  publishedAt        DateTime?
  sourcePublishedAt  DateTime?
  indexable          Boolean           @default(false)
  robots             String            @default("noindex,nofollow")
  schemaJson         Json?
  internalLinksJson  Json?
  factClaimsJson     Json?
  sourcesFooterHtml  String?           @db.Text
  views              Int               @default(0)
  uniqueViews        Int               @default(0)
  topicId            String?           @unique
  topic              NewsTopic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  portalPostId       String?
  portalPost         Post?
  socialTitle        String?
  socialExcerpt      String?           @db.Text
  socialImageUrl     String?
  facebookQueued     Boolean           @default(false)
  authorLabel        String            @default("Redakce XXREALIT")
  aiGenerated        Boolean           @default(true)
  editorNotes        String?           @db.Text
  rejectedReason     String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  sources            NewsArticleSource[]
  analytics          NewsArticleAnalytics?
  auditLogs          NewsAuditLog[]
  aiReelCandidates     ArticleReelCandidate[]
  aiInfluencerReelJobs AiInfluencerReelJob[]
  @@index([status, publishedAt])
  @@index([category, status])
  @@index([indexable, publishedAt])
}

model NewsSourceItem {
  id                String                 @id @default(cuid())
  sourceId          String
  source            NewsSource             @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId        String?
  sourceUrl         String
  canonicalUrl      String?
  title             String
  summary           String?                @db.Text
  publishedAt       DateTime?
  fetchedAt         DateTime               @default(now())
  author            String?
  imageUrl          String?
  rawMetadata       Json?
  contentHash       String
  titleFingerprint  String?
  status            NewsSourceItemStatus   @default(NEW)
  relevanceScore    Int?
  seoPotential      Int?
  userInterest      Int?
  freshnessScore    Int?
  trustScore        Int?
  trendScore        Int                    @default(0)
  editorialDecision NewsEditorialDecision?
  topicId           String?
  topic             NewsTopic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  duplicateOfId     String?
  errorMessage      String?                @db.Text
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  articleSources    NewsArticleSource[]
  @@unique([sourceId, contentHash])
  @@index([sourceId, externalId])
  @@index([status, fetchedAt])
  @@index([topicId])
  @@index([canonicalUrl])
}

model NewsArticleSource {
  id                String          @id @default(cuid())
  articleId         String
  article           NewsArticle     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sourceId          String?
  sourceItemId      String?
  sourceItem        NewsSourceItem? @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  sourceName        String
  sourceUrl         String
  sourcePublishedAt DateTime?
  @@index([articleId])
}

model NewsArticleAnalytics {
  articleId       String      @id
  article         NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  views           Int         @default(0)
  uniqueViews     Int         @default(0)
  ctrListings     Int         @default(0)
  ctrCompanies    Int         @default(0)
  ctrRegistration Int         @default(0)
  shares          Int         @default(0)
  avgReadSeconds  Int?
  organicVisits   Int         @default(0)
  updatedAt       DateTime    @updatedAt
}

model NewsWorkerJob {
  id          String              @id @default(cuid())
  type        NewsWorkerJobType
  status      NewsWorkerJobStatus @default(PENDING)
  payload     Json?
  progress    Int                 @default(0)
  result      Json?
  error       String?             @db.Text
  startedAt   DateTime?
  finishedAt  DateTime?
  heartbeatAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  @@index([type, status, createdAt])
}

model NewsAuditLog {
  id        String       @id @default(cuid())
  articleId String?
  article   NewsArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  event     String
  message   String       @db.Text
  metadata  Json?
  createdAt DateTime     @default(now())
  @@index([event, createdAt])
  @@index([articleId, createdAt])
}

enum EditorialReelJobStatus {
  DRAFT
  QUEUED
  RENDERING
  READY
  PUBLISHING
  PUBLISHED
  FAILED
}

enum EditorialReelOwnershipType {
  OWNED
  EXTERNAL
}

enum ReelPlatformPublishStatus {
  SKIPPED
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  AUTH_REQUIRED
  QUOTA_EXCEEDED
}

enum YouTubePublishJobStatus {
  QUEUED
  AUTHENTICATING
  UPLOADING
  PROCESSING
  PUBLISHED
  FAILED
  AUTH_REQUIRED
  QUOTA_EXCEEDED
}

enum ReelNarrationMode {
  NONE
  MUSIC
  AI_VOICE
  AI_AVATAR
}

enum ReelHookMode {
  TEMPLATE
  AI
  AI_FALLBACK
}

enum YoutubeSourceSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  IGNORED
}

enum ReelTransitionStyle {
  FADE
  ZOOM
  SLIDE
  CROSSFADE
}

/// Spravovatelné kategorie redakčních zdrojů (YouTube kanály, RSS)
model ContentSourceCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sources              NewsSource[]
  reelJobs             EditorialReelJob[]
  youtubeSuggestions   YouTubeSourceSuggestion[]
}

/// AI návrh YouTube kanálu ke schválení adminem
model YouTubeSourceSuggestion {
  id               String                        @id @default(cuid())
  channelId        String
  channelTitle     String
  channelUrl       String
  thumbnailUrl     String?
  description      String?                       @db.Text
  categoryId       String
  category         ContentSourceCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subscriberCount  Int?
  videoCount       Int?
  lastVideoAt      DateTime?
  relevanceScore   Int                           @default(0)
  reason           String?                       @db.Text
  status           YoutubeSourceSuggestionStatus @default(PENDING)
  suggestedBy      String                        @default("ai_discovery")
  approvedBy       String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectedBy       String?
  createdSourceId  String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  @@unique([channelId, categoryId])
  @@index([status, relevanceScore])
  @@index([categoryId, status])
}

/// Historie běhů YouTube channel discovery
model YouTubeDiscoveryRun {
  id                 String    @id @default(cuid())
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  triggeredBy        String    @default("admin")
  categorySlug       String?
  queriesCount       Int       @default(0)
  rawResults         Int       @default(0)
  uniqueChannels     Int       @default(0)
  existingSources    Int       @default(0)
  existingCandidates Int       @default(0)
  belowThreshold     Int       @default(0)
  duplicates         Int       @default(0)
  newCandidates      Int       @default(0)
  errors             Int       @default(0)
  searchRequests     Int       @default(0)
  diagnosticsJson    Json?
  @@index([startedAt])
}

/// Šablona Facebook Reel kompilace
model EditorialReelTemplate {
  id              String              @id @default(cuid())
  name            String
  introSec        Float               @default(2)
  segmentSec      Float               @default(4)
  outroSec        Float               @default(3)
  videosPerReel   Int                 @default(5)
  transition      ReelTransitionStyle @default(FADE)
  showLogo        Boolean             @default(true)
  showVideoTitle  Boolean             @default(true)
  showChannelTitle Boolean            @default(true)
  showCategory    Boolean             @default(true)
  ctaText         String              @default("Další videa najdete na XXREALIT.cz")
  introText       String?
  hookMode        ReelHookMode        @default(AI_FALLBACK)
  generateHookText Boolean            @default(true)
  useFirstVideoAsIntro Boolean        @default(true)
  showFirstVideoTitle Boolean         @default(true)
  musicTrackId    String?
  musicTrack      ShortsMusicTrack?   @relation(fields: [musicTrackId], references: [id], onDelete: SetNull)
  narrationMode   ReelNarrationMode   @default(MUSIC)
  isDefault       Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  jobs            EditorialReelJob[]
}

/// Fronta / historie Facebook Reel kompilací z YouTube obsahu
model EditorialReelJob {
  id                   String                 @id @default(cuid())
  status               EditorialReelJobStatus @default(DRAFT)
  title                String?
  templateId           String?
  template             EditorialReelTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  categoryId           String?
  category             ContentSourceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  videoCount           Int                    @default(0)
  renderError          String?                @db.Text
  publishError         String?                @db.Text
  failedStage          String?
  errorCode            String?
  lastAttemptAt        DateTime?
  attemptCount         Int                    @default(0)
  templateSnapshot     Json?
  videoPath            String?
  videoUrl             String?
  facebookPostId       String?
  facebookPermalink      String?
  facebookPublishStatus  ReelPlatformPublishStatus @default(SKIPPED)
  ownershipType          EditorialReelOwnershipType @default(OWNED)
  youtubeVideoId         String?
  youtubePermalink       String?
  youtubePublishStatus   ReelPlatformPublishStatus @default(SKIPPED)
  youtubePublishError    String?                @db.Text
  youtubePublishedAt     DateTime?
  shortsCollectionId   String?
  shortsCollection     ShortsCollection?      @relation(fields: [shortsCollectionId], references: [id], onDelete: SetNull)
  dedupeKey            String?                @unique
  scheduledAt          DateTime?
  renderedAt           DateTime?
  publishedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  segments             EditorialReelSegment[]
  youtubePublishJobs   YouTubePublishJob[]
  @@index([status, createdAt])
  @@index([categoryId, status])
}

model EditorialReelSegment {
  id             String           @id @default(cuid())
  jobId          String
  job            EditorialReelJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  postId         String
  post           Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  sortOrder      Int              @default(0)
  thumbnailUrl   String?
  title          String?
  channelTitle   String?
  categoryLabel  String?
  @@index([jobId, sortOrder])
  @@index([postId])
}

/// Kurátorovaná sada Shorts pro deep-link (např. z Facebook Reel)
model ShortsCollection {
  id        String   @id @default(cuid())
  title     String
  source    String   @default("facebook-reel")
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     ShortsCollectionItem[]
  reelJobs  EditorialReelJob[]
}

model ShortsCollectionItem {
  id           String           @id @default(cuid())
  collectionId String
  collection   ShortsCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  postId       String?
  post         Post?            @relation(fields: [postId], references: [id], onDelete: SetNull)
  feedKey      String
  sortOrder    Int              @default(0)
  @@index([collectionId, sortOrder])
  @@index([feedKey])
}

enum AiInfluencerReelJobStatus {
  ARTICLE_PUBLISHED
  EVALUATING
  CANDIDATE
  SCRIPT_GENERATING
  SCRIPT_READY
  VOICE_GENERATING
  VOICE_READY
  AVATAR_GENERATING
  AVATAR_READY
  RENDERING
  READY
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  SKIPPED_QUALITY
  SKIPPED_DUPLICATE
  FAILED
  CANCELLED
}

enum AiInfluencerApprovalMode {
  MANUAL
  SEMI_AUTO
  FULL_AUTO
}

enum AiInfluencerQualityMode {
  ECONOMY
  STANDARD
  PREMIUM
}

enum AiAvatarProviderType {
  HEYGEN
  DID
}

enum AiVoiceProviderType {
  ELEVENLABS
}

enum AiInfluencerContentFormat {
  REALITNI_MINUTA
  CENY_NEMOVITOSTI
  HYPOTEKY
  TIP_PRO_MAJITELE
  TIP_PRO_KUPUJICI
  REKONSTRUKCE
  VEDELI_JSTE
  BREAKING_NEWS
}

enum ProviderGenerationType {
  VOICE
  AVATAR
}

enum ProviderGenerationStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}

model AiInfluencerProfile {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  avatarProvider    AiAvatarProviderType @default(HEYGEN)
  avatarId          String?
  voiceProvider     AiVoiceProviderType @default(ELEVENLABS)
  voiceId           String?
  language          String              @default("cs-CZ")
  personalityPrompt String?             @db.Text
  defaultStyle      String?
  defaultDuration   Int                 @default(35)
  virtualPresenter  Boolean             @default(true)
  enabled           Boolean             @default(true)
  voiceSpeed        Float?
  voiceStability    Float?
  voiceStyle        Float?
  renderPreset      String?             @default("modern_xxrealit")
  renderSettingsJson Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  jobs              AiInfluencerReelJob[]
}

model ArticleReelCandidate {
  id                 String   @id @default(cuid())
  articleId          String
  article            NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reelPotentialScore Int
  topicInterest      Int?
  freshness          Int?
  hookPotential      Int?
  practicalValue     Int?
  emotionalInterest  Int?
  visualPotential    Int?
  localInterest      Int?
  sourceTrust        Int?
  duplicationPenalty Int?
  reasoningSummary   Json?
  skipped            Boolean  @default(false)
  evaluatedAt        DateTime @default(now())
  topicClusterId     String?
  jobs               AiInfluencerReelJob[]
  @@index([articleId, evaluatedAt])
  @@index([reelPotentialScore])
}

model SrealityImportDraft {
  id                    String    @id @default(cuid())
  adminUserId           String
  sourceUrl             String
  sourceExternalId      String?
  status                String    @default("preview")
  prefillJson           Json
  brokerJson            Json?
  imagesJson            Json      @default("[]")
  imageImportStats      Json?
  aiTextJson            Json?
  brokerMatchStatus     String    @default("NOT_FOUND")
  matchedBrokerContactId String?
  propertyId            String?
  property              Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  settingsJson          Json?
  publishedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([adminUserId])
  @@index([sourceUrl])
  @@index([sourceExternalId])
  @@index([propertyId])
  @@index([status])
}

model AiInfluencerReelJob {
  id                   String                    @id @default(cuid())
  articleId            String?
  article              NewsArticle?              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  propertyId           String?
  property             Property?                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  candidateId          String?
  candidate            ArticleReelCandidate?       @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  profileId            String
  profile              AiInfluencerProfile         @relation(fields: [profileId], references: [id])
  status               AiInfluencerReelJobStatus @default(EVALUATING)
  progressPercent      Int                       @default(0)
  currentStep          String?
  skipReason           String?                   @db.Text
  forceOverride        Boolean                   @default(false)
  spokenTextTts        String?                   @db.Text
  nextRetryAt          DateTime?
  automationPaused     Boolean                   @default(false)
  contentFormat        AiInfluencerContentFormat?
  failedStage          String?
  errorCode            String?
  errorMessage         String?                   @db.Text
  attemptCount         Int                       @default(0)
  lastAttemptAt        DateTime?
  hookCandidates       Json?
  selectedHook         String?
  scriptJson           Json?
  spokenText           String?                   @db.Text
  captionTitle         String?
  captionDescription   String?                   @db.Text
  hashtags             String?
  estimatedDurationSec Int?
  scriptHash           String?
  voiceStoragePath     String?
  voiceStorageUrl      String?
  voiceHash            String?
  avatarStoragePath    String?
  avatarStorageUrl     String?
  avatarHash           String?
  avatarExternalJobId  String?
  scenesJson           Json?
  musicTrackId         String?
  videoPath            String?
  videoUrl             String?
  finalMasterUrl       String?
  baseMasterUrl        String?
  thumbnailUrl         String?
  renderPreset         String?
  renderSettingsJson   Json?
  validationPassed     Boolean?
  validationErrors     Json?
  timelineEvents       Json?
  renderedAt           DateTime?
  facebookPublishStatus ReelPlatformPublishStatus @default(SKIPPED)
  facebookPostId       String?
  facebookPermalink    String?
  facebookPublishedAt  DateTime?
  facebookPublishError String?                   @db.Text
  youtubePublishStatus ReelPlatformPublishStatus @default(SKIPPED)
  youtubeVideoId       String?
  youtubePermalink     String?
  youtubePublishedAt   DateTime?
  youtubePublishError  String?                   @db.Text
  youtubePrivacyStatus String?
  instagramPublishStatus ReelPlatformPublishStatus @default(SKIPPED)
  instagramMediaId     String?
  instagramPermalink   String?
  instagramUsername    String?
  instagramPublishedAt DateTime?
  instagramPublishError String?                  @db.Text
  publishedAt          DateTime?
  aiCostEstimated      Float                     @default(0)
  voiceCostEstimated   Float                     @default(0)
  avatarCostEstimated  Float                     @default(0)
  renderCostEstimated  Float                     @default(0)
  totalExternalCost    Float                     @default(0)
  postId               String?
  post                 Post?                     @relation(fields: [postId], references: [id], onDelete: SetNull)
  sourceType           String                    @default("AI_INFLUENCER")
  ownershipType        EditorialReelOwnershipType @default(OWNED)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  providerGenerations  ProviderGeneration[]
  @@index([status, createdAt])
  @@index([articleId])
  @@index([propertyId])
}

model ProviderGeneration {
  id            String                   @id @default(cuid())
  jobId         String?
  job           AiInfluencerReelJob?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  type          ProviderGenerationType
  contentHash   String
  provider      String
  status        ProviderGenerationStatus @default(QUEUED)
  externalJobId String?
  storagePath   String?
  storageUrl    String?
  costEstimated Float                    @default(0)
  errorMessage  String?                  @db.Text
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  @@unique([type, contentHash, provider])
  @@index([status, createdAt])
}
