  preregistration ClientPreregistration? @relation(fields: [preregistrationId], references: [id], onDelete: SetNull)

  @@index([workerId, createdAt])
  @@index([preregistrationId])
  @@index([clientUserId])
  @@index([action])
}

/// Nastavení provizí pracovníků portálu (singleton).
model WorkerCommissionSetting {
  id                 String   @id @default("default")
  defaultPercent     Int      @default(10)
  defaultFixedAmount Int      @default(0)
  minTopUpAmount     Int      @default(300)
  validityDays       Int      @default(365)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Procento provize podle role doporučeného klienta.
model WorkerCommissionRoleRate {
  role         UserRole @id
  percent      Int
  fixedAmount  Int      @default(0)
}

/// Provize pracovníka z potvrzeného dobití kreditu klienta (jen placený kredit).
model WorkerCommission {
  id               String                 @id @default(cuid())
  workerId         String
  referredUserId   String
  creditTopUpId    String                 @unique
  amount           Int
  percent          Int
  commissionAmount Int
  status           WorkerCommissionStatus @default(PENDING)
  createdAt        DateTime               @default(now())
  paidAt           DateTime?

  worker       User                   @relation("WorkerCommissionWorker", fields: [workerId], references: [id], onDelete: Cascade)
  referredUser User                   @relation("WorkerCommissionClient", fields: [referredUserId], references: [id], onDelete: Cascade)
  creditTopUp  CreditTopUpTransaction @relation(fields: [creditTopUpId], references: [id], onDelete: Cascade)

  @@index([workerId, createdAt])
  @@index([referredUserId, createdAt])
  @@index([status])
}

/// Interní zpráva admin ↔ pracovník portálu.
model WorkerInternalMessage {
  id           String                      @id @default(cuid())
  workerId     String
  senderRole   WorkerInternalMessageSender
  senderUserId String
  body         String                      @db.Text
  readAt       DateTime?
  bulkMessageId String?
  createdAt    DateTime                    @default(now())

  worker      User  @relation("WorkerInternalMessageWorker", fields: [workerId], references: [id], onDelete: Cascade)
  sender      User  @relation("WorkerInternalMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  bulkMessage WorkerBulkMessage? @relation(fields: [bulkMessageId], references: [id], onDelete: SetNull)

  @@index([workerId, createdAt])
  @@index([workerId, readAt])
}

/// Hromadná zpráva / šablona pro pracovníky portálu.
model WorkerBulkMessage {
  id              String    @id @default(cuid())
  campaignName    String
  subject         String    @default("")
  body            String    @db.Text
  filterJson      Json?
  recipientCount  Int       @default(0)
  emailsSent      Int       @default(0)
  emailErrors     Int       @default(0)
  isTemplate      Boolean   @default(false)
  templateName    String?
  createdById     String
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  createdBy    User                         @relation("WorkerBulkMessageCreator", fields: [createdById], references: [id], onDelete: Cascade)
  recipients   WorkerBulkMessageRecipient[]
  internalMsgs WorkerInternalMessage[]

  @@index([createdById, createdAt])
  @@index([isTemplate, createdAt])
}

/// Příjemce hromadné zprávy.
model WorkerBulkMessageRecipient {
  id                String  @id @default(cuid())
  bulkMessageId     String
  workerId          String
  internalMessageId String?
  emailSent         Boolean @default(false)
  emailError        String? @db.Text

  bulkMessage WorkerBulkMessage @relation(fields: [bulkMessageId], references: [id], onDelete: Cascade)
  worker      User              @relation("WorkerBulkMessageRecipientWorker", fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([bulkMessageId, workerId])
  @@index([workerId])
}

/// Nastavení denních výzev k dokončení profilu pracovníka.
model WorkerProfileReminderSettings {
  userId             String    @id
  enabled            Boolean   @default(false)
  lastReminderSentAt DateTime?
  remindersSentCount Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Žádost pracovníka o ukončení spolupráce.
model WorkerCooperationCancelRequest {
  id           String                        @id @default(cuid())
  workerId     String                        @unique
  reason       String?                       @db.Text
  status       WorkerCooperationCancelStatus @default(PENDING)
  requestedAt  DateTime                      @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  worker     User  @relation("WorkerCooperationCancelWorker", fields: [workerId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("WorkerCooperationCancelResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
}

/// Pracovní postup (návod) pro pracovníka nebo šablona.
model WorkerWorkGuide {
  id           String   @id @default(cuid())
  workerId     String?
  templateName String?
  enabled      Boolean  @default(false)
  isTemplate   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  worker User?                 @relation("WorkerWorkGuideWorker", fields: [workerId], references: [id], onDelete: Cascade)
  steps  WorkerWorkGuideStep[]

  @@index([workerId])
  @@index([isTemplate])
}

/// Krok pracovního postupu.
model WorkerWorkGuideStep {
  id        String @id @default(cuid())
  guideId   String
  sortOrder Int
  title     String @default("")
  body      String @db.Text

  guide WorkerWorkGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, sortOrder])
}

/// Náborový cíl portálu (koho hledáme).
model WorkerRecruitmentTarget {
  id          String                     @id @default(cuid())
  slug        String                     @unique
  targetType  WorkerRecruitmentTargetType? @unique
  name        String                     @default("")
  description String                     @default("") @db.Text
  workerNote  String                     @default("") @db.Text
  isActive    Boolean                    @default(false)
  sortOrder   Int                        @default(0)
  isCustom    Boolean                    @default(false)
  updatedAt   DateTime                   @updatedAt

  scenario     WorkerRecruitmentScenario?
  assignments  WorkerRecruitmentAssignment[]
  deliveries   WorkerRecruitmentDelivery[]
}

/// Scénář komunikace pro náborový cíl.
model WorkerRecruitmentScenario {
  id        String @id @default(cuid())
  targetId  String @unique
  title     String @default("")
  stepsJson Json

  target WorkerRecruitmentTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

/// Přiřazení náborového cíle konkrétnímu pracovníkovi.
model WorkerRecruitmentAssignment {
  id                String   @id @default(cuid())
  targetId          String
  workerId          String
  assignedByAdminId String
  assignedAt        DateTime @default(now())

  target     WorkerRecruitmentTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  worker     User                    @relation("WorkerRecruitmentAssignmentWorker", fields: [workerId], references: [id], onDelete: Cascade)
  assignedBy User                    @relation("WorkerRecruitmentAssignmentAdmin", fields: [assignedByAdminId], references: [id], onDelete: Cascade)

  @@unique([targetId, workerId])
  @@index([workerId, assignedAt])
}

/// Historie odeslání náborového cíle pracovníkům.
model WorkerRecruitmentDelivery {
  id              String   @id @default(cuid())
  targetId        String
  sentByAdminId   String
  recipientCount  Int      @default(0)
  emailsSent      Int      @default(0)
  emailErrors     Int      @default(0)
  sentAt          DateTime @default(now())

  target   WorkerRecruitmentTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  sentBy   User                    @relation("WorkerRecruitmentDeliveryAdmin", fields: [sentByAdminId], references: [id], onDelete: Cascade)

  @@index([targetId, sentAt])
}

/// Ověřovací soubor pro externí služby (TikTok, Google, Facebook…) — veřejně z kořene domény.
model VerificationFile {
  id                String   @id @default(cuid())
  filename          String   @unique
  mimeType          String
  content           String   @db.Text
  isActive          Boolean  @default(true)
  uploadedByAdminId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  uploadedBy User @relation("VerificationFileUploader", fields: [uploadedByAdminId], references: [id], onDelete: Cascade)

  @@index([filename, isActive])
}

enum SupportTicketStatus {
  NEW
  WAITING_REPLY
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  TECHNICAL
  LISTING
  PAYMENTS
  CREDITS
  BROKERS
  CONSTRUCTION
  INVESTORS
  FINANCIAL_ADVISORS
  REPORT_ISSUE
  BUSINESS_COOPERATION
  OTHER
}

enum SupportMessageAuthorType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum SupportTicketEmailDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

/// Interní ticket zákaznické podpory portálu.
model SupportTicket {
  id               String               @id @default(cuid())
  publicId         String               @unique
  userId           String?
  firstName        String
  lastName         String?
  phone            String
  whatsapp         String
  email            String
  subject          String
  category         SupportTicketCategory
  status           SupportTicketStatus  @default(NEW)
  assignedToId     String?
  ipAddress        String?
  userAgent        String?              @db.VarChar(512)
  gdprConsentAt    DateTime
  contactConsentAt DateTime
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  lastMessageAt    DateTime             @default(now())

  user       User?                  @relation("SupportTicketUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo User?                  @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportTicketMessage[]

  @@index([status, createdAt])
  @@index([category])
  @@index([email])
  @@index([phone])
  @@index([whatsapp])
  @@index([assignedToId])
  @@index([userId, createdAt])
  @@index([publicId])
}

model SupportTicketMessage {
  id             String                 @id @default(cuid())
  ticketId       String
  authorType     SupportMessageAuthorType
  authorUserId   String?
  body           String                 @db.Text
  isInternalNote Boolean                @default(false)
  source         String                 @default("web")
  emailMessageId String?
  emailInReplyTo String?
  emailReferences String?               @db.Text
  smtpMessageId  String?
  emailDeliveryStatus SupportTicketEmailDeliveryStatus?
  emailSentAt    DateTime?
  emailDeliveredAt DateTime?
  mailboxId      String?
  createdAt      DateTime               @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser User?         @relation("SupportTicketMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  mailbox    SupportEmailMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  attachments SupportTicketAttachment[]

  @@index([ticketId, createdAt])
  @@index([emailMessageId])
}

model SupportTicketAttachment {
  id         String   @id @default(cuid())
  messageId  String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storagePath String  @db.Text
  createdAt  DateTime @default(now())

  message SupportTicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/// Globální nastavení e-mailové podpory (singleton).
model SupportEmailSettings {
  id               String   @id @default("default")
  adminNotifyEmail String?
  updatedAt        DateTime @updatedAt
}

/// E-mailová schránka pro odesílání/příjem ticketů.
model SupportEmailMailbox {
  id                    String   @id @default(cuid())
  label                 String
  email                 String   @unique
  replyToEmail          String?
  smtpHost              String
  smtpPort              Int      @default(587)
  smtpSecure            Boolean  @default(false)
  smtpUser              String
  smtpPasswordEncrypted String   @db.Text
  imapHost              String?
  imapPort              Int?
  imapSecure            Boolean  @default(true)
  imapUser              String?
  imapPasswordEncrypted String?  @db.Text
  signatureHtml         String   @default("") @db.Text
  signatureText         String   @default("") @db.Text
  autoReplyEnabled      Boolean  @default(false)
  autoReplySubject      String?
  autoReplyHtml         String?  @db.Text
  autoReplyText         String?  @db.Text
  isDefault             Boolean  @default(false)
  active                Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  messages SupportTicketMessage[]

  @@index([active, sortOrder])
}

/// Nastavení interní analytiky portálu (singleton).
model AnalyticsSettings {
  id              String   @id @default("default")
  anonymizeIp     Boolean  @default(false)
  excludeStaff    Boolean  @default(true)
  trackingEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

/// Relace návštěvníka portálu.
model AnalyticsSession {
  id            String   @id @default(cuid())
  visitorId     String
  userId        String?
  ip            String?
  userAgent     String   @default("") @db.Text
  deviceType    String   @default("desktop")
  browser       String   @default("")
  os            String   @default("")
  language      String   @default("")
  country       String   @default("")
  city          String   @default("")
  referrer      String   @default("")
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  pageViewCount Int      @default(0)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  pageViews  AnalyticsPageView[]

  @@index([visitorId])
  @@index([userId])
  @@index([lastSeenAt])
  @@index([firstSeenAt])
  @@index([country, city])
}

/// Zobrazení stránky v rámci relace.
model AnalyticsPageView {
  id           String   @id @default(cuid())
  sessionId    String
  userId       String?
  url          String   @db.Text
  path         String
  title        String   @default("")
  referrer     String   @default("")
  previousPath String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  createdAt    DateTime @default(now())

  session AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  TIKTOK
}

enum PostSocialPublishType {
  POST
  REEL
  SHORT
}

enum PostSocialPublishStatus {
  PENDING
  UPLOADING
  PUBLISHED
  FAILED
}

/// Stav publikování příspěvku na jednotlivé sociální sítě.
model PostSocialPublish {
  id                  String                  @id @default(cuid())
  postId              String
  platform            SocialPlatform
  publishType         PostSocialPublishType   @default(POST)
  status              PostSocialPublishStatus @default(PENDING)
  externalId          String?
  externalUrl         String?
  errorMessage        String?                 @db.Text
  videoPreviewSeconds Int?
  publishedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
  @@index([postId])
  @@index([status])
}

enum SocialPublishContentType {
  POST
  PROPERTY
  SHORT
}

enum SocialPublishStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  SKIPPED
}

enum SocialPublishRepeatType {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM_DAYS
}

enum SocialPublishScheduleLastStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

enum SocialPublishTriggerSource {
  MANUAL
  SCHEDULE
  AUTO
}

/// Fronta automatického publikování na sociální sítě portálu XXREALIT.
model SocialPublishQueue {
  id              String                   @id @default(cuid())
  platform        SocialPlatform           @default(FACEBOOK)
  contentType     SocialPublishContentType
  contentId       String
  authorUserId    String?
  contentTitle    String                   @default("")
  status          SocialPublishStatus      @default(PENDING)
  attempts        Int                      @default(0)
  lastError       String?                  @db.Text
  publishedUrl    String?
  externalPostId  String?
  lastApiResponse Json?
  scheduledAt     DateTime?
  processedAt     DateTime?
  triggerSource   SocialPublishTriggerSource @default(AUTO)
  triggeredByUserId String?
  scheduleId      String?
  facebookPostType FacebookPostType?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  author User? @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  schedule SocialPublishSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  logs SocialPublishLog[]

  @@unique([platform, contentType, contentId])
  @@index([status, scheduledAt])
  @@index([status, createdAt])
  @@index([contentType, contentId])
  @@index([authorUserId])
  @@index([scheduleId])
}

/// Plánované / opakované publikování na sociální sítě.
model SocialPublishSchedule {
  id                 String                        @id @default(cuid())
  platform           SocialPlatform                @default(FACEBOOK)
  contentType        SocialPublishContentType
  contentId          String
  enabled            Boolean                       @default(true)
  nextRunAt          DateTime
  repeatType         SocialPublishRepeatType       @default(NONE)
  repeatIntervalDays Int?
  repeatUntil        DateTime?
  maxRuns            Int?
  runCount           Int                           @default(0)
  requireActive      Boolean                       @default(true)
  requireApproved    Boolean                       @default(true)
  /// true = Reel, false = běžné video, null = globální nastavení autopostu
  shortsPublishAsReel Boolean?
  lastRunAt          DateTime?
  lastPublishedAt    DateTime?
  lastStatus         SocialPublishScheduleLastStatus?
  lastError          String?                       @db.Text
  lastIntroVideoUsed        Boolean                @default(false)
  lastIntroVideoIdUsed      String?
  lastIntroVideoTitle       String?
  lastIntroVideoAttemptId   String?
  lastIntroVideoError       String?                @db.Text
  lastRawPropertyType       String?
  lastNormalizedPropertyType String?
  lastMatchedIntroPropertyType SocialIntroPropertyType?
  lastSourceListingVideoUrl String?
  lastFinalVideoUrl         String?
  lastFinalVideoGeneratedAt DateTime?
  lastTotalReelDurationSec  Float?
  createdByUserId    String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  createdBy User? @relation("SocialPublishScheduleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  queueItems SocialPublishQueue[]
  logs SocialPublishLog[]

  @@unique([platform, contentType, contentId])
  @@index([enabled, nextRunAt])
  @@index([contentType, contentId])
}

/// Historie publikování (včetně opakování).
model SocialPublishLog {
  id                       String                     @id @default(cuid())
  platform                 SocialPlatform             @default(FACEBOOK)
  contentType              SocialPublishContentType
  contentId                String
  queueId                  String?
  scheduleId               String?
  status                   SocialPublishStatus
  externalPostId           String?
  externalReelId           String?
  publishedUrl             String?
  reelPublishedUrl         String?
  lastError                String?                    @db.Text
  facebookPostType         FacebookPostType?
  publishKind              SocialPublishKind?
  contentTitle             String?
  teaserDurationSec        Float?
  originalVideoDurationSec Float?
  introVideoUsed           Boolean                @default(false)
  introVideoPropertyType   SocialIntroPropertyType?
  introVideoDurationSec    Float?
  totalReelDurationSec     Float?
  introVideoError          String?                @db.Text
  introVideoIdUsed         String?
  introVideoTitle          String?
  sourceListingVideoUrl    String?
  finalVideoUrl            String?
  finalVideoGeneratedAt    DateTime?
  graphApiResponse         Json?
  triggerSource            SocialPublishTriggerSource
  triggeredByUserId        String?
  createdAt                DateTime                   @default(now())

  queue       SocialPublishQueue? @relation(fields: [queueId], references: [id], onDelete: SetNull)
  schedule    SocialPublishSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  triggeredBy User? @relation("SocialPublishLogTrigger", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([contentType, contentId, createdAt])
  @@index([queueId])
  @@index([scheduleId])
  @@index([triggeredByUserId])
}

/// Log běhu minutového scheduleru plánovaného publikování.
model SocialPublishSchedulerLog {
  id             String   @id @default(cuid())
  checkedAt      DateTime @default(now())
  source         String   @default("cron")
  dueCount       Int      @default(0)
  publishedCount Int      @default(0)
  failedCount    Int      @default(0)
  skippedCount   Int      @default(0)
  details        Json?
  createdAt      DateTime @default(now())

  @@index([checkedAt])
}

enum SocialIntroPropertyType {
  BYT
  DUM
  POZEMEK
  KOMERCNI
  GARAZ
  NOVOSTAVBA
  PRONAJEM
  OSTATNI
}

/// Úvodní reklamní video před Reel inzerátu na sociálních sítích.
model SocialIntroVideo {
  id              String                 @id @default(cuid())
  title           String
  propertyType    SocialIntroPropertyType
  videoUrl        String
  thumbnailUrl    String?
  durationSeconds Float?
  active          Boolean                @default(true)
  priority        Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  compositionCaches SocialReelCompositionCache[]

  @@index([propertyType, active, priority])
}

/// Cache spojeného Reel videa (úvod + inzerát) — zneplatní se při změně úvodního nebo zdrojového videa.
model SocialReelCompositionCache {
  id                    String   @id @default(cuid())
  cacheKey              String   @unique
  introVideoId          String
  introVideoUpdatedAt   DateTime
  sourceListingVideoUrl String
  listingTeaserSeconds  Float
  finalVideoUrl         String
  finalVideoSizeBytes   Int?
  totalDurationSec      Float?
  ffmpegCommand         String?  @db.Text
  createdAt             DateTime @default(now())

  introVideo SocialIntroVideo @relation(fields: [introVideoId], references: [id], onDelete: Cascade)

  @@index([introVideoId])
  @@index([sourceListingVideoUrl])
}

enum TikTokPublishJobStatus {
  WAITING
  UPLOADING
  UPLOADED
  FAILED
  NEEDS_REAUTH
}

/// Propojení oficiálního TikTok účtu portálu XXREALIT.
model TikTokConnection {
  id               String   @id @default(cuid())
  openId           String   @unique
  accessToken      String   @db.Text
  refreshToken     String   @db.Text
  scope            String
  expiresAt        DateTime
  refreshExpiresAt DateTime?
  accountName      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Dočasná OAuth session (PKCE state + code_verifier).
model TikTokOAuthSession {
  id           String   @id
  adminUserId  String
  codeVerifier String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

/// Fronta publikování inzerátů na TikTok.
model TikTokPublishJob {
  id              String                 @id @default(cuid())
  listingId       String
  videoUrl        String
  caption         String                 @db.Text
  hashtags        String                 @db.Text
  status          TikTokPublishJobStatus @default(WAITING)
  tiktokPublishId String?
  tiktokVideoUrl  String?
  errorMessage    String?                @db.Text
  attempts        Int                    @default(0)
  isDraftInbox    Boolean                @default(false)
  publishedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  logs TikTokPublishLog[]

  @@index([status, createdAt])
  @@index([listingId, createdAt])
}

/// Log pokusů o publikování na TikTok.
model TikTokPublishLog {
  id          String   @id @default(cuid())
  jobId       String
  listingId   String
  status      String
  message     String?  @db.Text
  rawResponse Json?
  createdAt   DateTime @default(now())

  job TikTokPublishJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([listingId, createdAt])
}

/// Veřejné marketingové statistiky pro stránku O portálu.
enum PublicPortalStatValueSource {
  MANUAL
  DATABASE
  API
}

model PublicPortalStat {
  id             String                      @id @default(cuid())
  key            String                      @unique
  label          String
  realValue      Float                       @default(0)
  multiplier     Float                       @default(1)
  manualValue    Float?
  displayedValue Float                       @default(0)
  enabled        Boolean                     @default(true)
  order          Int                         @default(0)
  category       String?
  icon           String?
  valueSource    PublicPortalStatValueSource @default(MANUAL)
  lastFetchedAt  DateTime?
  lastFetchError String?                     @db.Text
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([enabled, order])
}

/// Log importů statistik O portálu.
model PublicPortalStatImportLog {
  id           String   @id @default(cuid())
  statKey      String
  source       String
  fetchedValue Float?
  error        String?  @db.Text
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([statKey, createdAt])
  @@index([createdAt])
}

/// Měsíční data pro graf na stránce O portálu.
model PublicPortalMonthlyStat {
  id          String   @id @default(cuid())
  month       String
  visits      Float    @default(0)
  views       Float    @default(0)
  socialReach Float    @default(0)
  leads       Float    @default(0)
  multiplier  Float    @default(1)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([month])
  @@index([enabled, month])
}

/// Veřejný ceník leadů / kontaktů na stránce O portálu.
model LeadPrice {
  id             String   @id @default(cuid())
  title          String
  description    String   @db.Text
  priceCzk       Int      @default(0)
  priceCredits   Int      @default(0)
  appliesToRoles String   @default("ALL")
  billedToLabel  String?
  active         Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, order])
}
