/// Hromadná zpráva / šablona pro pracovníky portálu.
model WorkerBulkMessage {
  id              String    @id @default(cuid())
  campaignName    String
  subject         String    @default("")
  body            String    @db.Text
  filterJson      Json?
  recipientCount  Int       @default(0)
  emailsSent      Int       @default(0)
  emailErrors     Int       @default(0)
  isTemplate      Boolean   @default(false)
  templateName    String?
  createdById     String
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

