  @@index([workerId, createdAt])
  @@index([email])
  @@index([phone])
  @@index([whatsappPhone])
  @@index([status])
}

/// Profil pracovníka portálu — provize, limity bonusů, admin poznámky.
model WorkerProfile {
  userId                String   @id
  commissionPercent     Int?
  maxBonusPerClient     Int      @default(3000)
  maxBonusPerDay        Int?
  maxBonusPerMonth      Int?
  canAssignBonusCredits Boolean  @default(true)
  isActive              Boolean  @default(true)
  adminNotes            String?  @db.Text
  permissions           Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
