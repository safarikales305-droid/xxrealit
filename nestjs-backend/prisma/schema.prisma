  preregistration ClientPreregistration? @relation(fields: [preregistrationId], references: [id], onDelete: SetNull)

  @@index([workerId, createdAt])
  @@index([preregistrationId])
  @@index([clientUserId])
  @@index([action])
}

/// Nastavení provizí pracovníků portálu (singleton).
model WorkerCommissionSetting {
  id                 String   @id @default("default")
  defaultPercent     Int      @default(10)
  defaultFixedAmount Int      @default(0)
  minTopUpAmount     Int      @default(300)
  validityDays       Int      @default(365)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Procento provize podle role doporučeného klienta.
model WorkerCommissionRoleRate {
  role         UserRole @id
  percent      Int
  fixedAmount  Int      @default(0)
}

/// Provize pracovníka z potvrzeného dobití kreditu klienta (jen placený kredit).
model WorkerCommission {
  id               String                 @id @default(cuid())
  workerId         String
  referredUserId   String
  creditTopUpId    String                 @unique
  amount           Int
  percent          Int
  commissionAmount Int
  status           WorkerCommissionStatus @default(PENDING)
  createdAt        DateTime               @default(now())
  paidAt           DateTime?

  worker       User                   @relation("WorkerCommissionWorker", fields: [workerId], references: [id], onDelete: Cascade)
  referredUser User                   @relation("WorkerCommissionClient", fields: [referredUserId], references: [id], onDelete: Cascade)
  creditTopUp  CreditTopUpTransaction @relation(fields: [creditTopUpId], references: [id], onDelete: Cascade)

  @@index([workerId, createdAt])
  @@index([referredUserId, createdAt])
  @@index([status])
}

/// Interní zpráva admin ↔ pracovník portálu.
model WorkerInternalMessage {
  id           String                      @id @default(cuid())
  workerId     String
  senderRole   WorkerInternalMessageSender
  senderUserId String
  body         String                      @db.Text
  readAt       DateTime?
  bulkMessageId String?
  createdAt    DateTime                    @default(now())

  worker      User  @relation("WorkerInternalMessageWorker", fields: [workerId], references: [id], onDelete: Cascade)
  sender      User  @relation("WorkerInternalMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  bulkMessage WorkerBulkMessage? @relation(fields: [bulkMessageId], references: [id], onDelete: SetNull)

  @@index([workerId, createdAt])
  @@index([workerId, readAt])
