model Post {
  id          String   @id @default(cuid())
  title       String   @default("")
  description String   @default("")
  imageUrl    String?
  videoUrl    String?
  price       Int      @default(0)
  city        String   @default("")
  latitude    Float?
  longitude   Float?
  type        String   @default("post")
  category    PostCategory @default(MAKLERI)
  content     String?
  /// Externí odkaz (Sreality, Bezrealitky…) — náhled jako u Facebooku.
  externalUrl         String?
  previewTitle        String?
  previewDescription  String?  @db.Text
  previewImage        String?
  previewSiteName     String?
  /// Příspěvek importovaný z propojené Facebook stránky.
  isFacebookPagePost  Boolean    @default(false)
  facebookPermalink   String?
  /// INTERNAL = ručně vytvořený; FACEBOOK = import ze scraperu / budoucí Meta API.
  source              PostSource @default(INTERNAL)
  facebookExternalId  String?    @unique
  /// ID role-specifického profesionálního profilu (AgentProfile, CompanyProfile, …).
  professionalProfileId String?
  facebookPostType    FacebookPostType?
  facebookEmbedUrl    String?          @db.Text
  /// Náhled videa z Facebook Graph API (poster u HTML5 přehrávače).
  facebookVideoThumbnail   String?
  /// Délka videa v sekundách z Graph API.
  facebookVideoDurationSec Float?
  /// Přímé video URL z Graph API (source) — může se lišit od videoUrl po expiraci.
  facebookVideoSourceUrl   String?
  facebookVideoHasAudio    Boolean?
  facebookVideoMimeType    String?
  publishedAt         DateTime?
  /// Volitelný zvuk/hudba k video příspěvku (sdílená knihovna Shorts hudby).
  soundTrackId        String?
  soundTrack          ShortsMusicTrack? @relation(fields: [soundTrackId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       Media[]
  reactions   PostReaction[]
  favorites   Favorite[]
  comments    Comment[]
  whatsappMessages WhatsAppMessage[]
  /// Reálné like (sync s PostReaction LIKE).
  realLikes         Int      @default(0)
  /// Ručně nastavené like.
  manualLikes       Int      @default(0)
  /// Autopilot like.
  autopilotLikes    Int      @default(0)
  likesAutopilotEnabled Boolean @default(true)
  likesAutopilotRatePerHour Int?
  likesAutopilotMaxTotal Int?
  lastAutopilotLikesAt DateTime?
  autopilotLikesDayKey String @default("")
  autopilotLikesAddedToday Int @default(0)
  postSocialPublishes PostSocialPublish[]
  /// SEO slug: např. nazev-prispevku-abc12
  slug            String?  @unique
  seoTitle        String?
  seoDescription  String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([slug])
  @@index([source, createdAt])
  @@index([latitude, longitude])
  @@index([soundTrackId])
}

