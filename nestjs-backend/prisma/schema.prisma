  tipster        User?      @relation("ContactLeadTipster", fields: [tipsterUserId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([tipId])
  @@index([sourceType, sourceId])
  @@index([ownerUserId, createdAt])
  @@index([interestedUserId, createdAt])
  @@index([tipsterUserId, createdAt])
}

/// Odemčení kontaktu tipařského tipu (idempotentní — jednou zaplaceno, pak zdarma).
