  isPublished            Boolean   @default(false)
  requireReacceptOnLogin Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  publishedAt            DateTime?
  createdById            String?
  createdBy              User?     @relation("PortalTermsAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([version])
  @@index([isPublished, publishedAt])
}

/// Veřejná prezentační landing page portálu (CMS).
model PortalPresentationPage {
