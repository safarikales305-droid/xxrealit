model WorkerRecruitmentScenario {
  id        String @id @default(cuid())
  targetId  String @unique
  title     String @default("")
  stepsJson Json

  target WorkerRecruitmentTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

/// Přiřazení náborového cíle konkrétnímu pracovníkovi.
model WorkerRecruitmentAssignment {
  id                String   @id @default(cuid())
  targetId          String
  workerId          String
  assignedByAdminId String
  assignedAt        DateTime @default(now())

  target     WorkerRecruitmentTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  worker     User                    @relation("WorkerRecruitmentAssignmentWorker", fields: [workerId], references: [id], onDelete: Cascade)
  assignedBy User                    @relation("WorkerRecruitmentAssignmentAdmin", fields: [assignedByAdminId], references: [id], onDelete: Cascade)

  @@unique([targetId, workerId])
  @@index([workerId, assignedAt])
}

/// Historie odeslání náborového cíle pracovníkům.
model WorkerRecruitmentDelivery {
  id              String   @id @default(cuid())
  targetId        String
  sentByAdminId   String
  recipientCount  Int      @default(0)
  emailsSent      Int      @default(0)
  emailErrors     Int      @default(0)
  sentAt          DateTime @default(now())

  target   WorkerRecruitmentTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  sentBy   User                    @relation("WorkerRecruitmentDeliveryAdmin", fields: [sentByAdminId], references: [id], onDelete: Cascade)

  @@index([targetId, sentAt])
