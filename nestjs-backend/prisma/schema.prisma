/// Veřejný registr firem z ARES (odděleně od User.CompanyProfile).
model CompanyDirectoryEntry {
  id        String @id @default(cuid())
  ico       String @unique
  dic       String?
  name      String
  slug      String @unique

  legalForm     String?
  companyStatus String?

  street            String?
  city              String?
  postalCode        String?
  district          String?
  region            String?
  country           String  @default("CZ")
  registeredAddress String?

  aresSource       Boolean   @default(true)
  aresLastSyncAt   DateTime?
  aresRawUpdatedAt DateTime?

  categories         CompanyDirectoryCategory[] @default([])
  businessActivities String[]                   @default([])

  publicProfile Boolean                       @default(true)
  profileStatus CompanyDirectoryProfileStatus @default(UNCLAIMED)

  claimedAt       DateTime?
  claimedByUserId String?
  claimedByUser   User?     @relation("CompanyDirectoryClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  website String?
  email   String?
  phone   String?

  googlePlaceId           String?
  googleRating            Float?
  googleReviewCount       Int?
  googleLastSyncAt        DateTime?
  googleMatchConfidence   CompanyGoogleMatchConfidence?
  googleMatchStatus       CompanyGoogleMatchStatus @default(NOT_SEARCHED)
  googleMatchScore        Float?
  googleMapsUri           String?
  googleReviewsCache      Json?
  googleReviewsCacheExpiresAt DateTime?

  verifiedBusinessEmail String?
  xxrealitRatingAverage Float?
  xxrealitReviewCount   Int @default(0)

  verificationStatus CompanyDirectoryVerificationStatus @default(UNVERIFIED)

  aiSummary         String? @db.Text
  aiPositiveSummary Json?
  aiNegativeSummary Json?
  aiNeutralTopics   Json?
  sentimentScore    Float?

  reliabilityScore   Float?
  reliabilityFactors Json?

  logoUrl String?
  coverImageUrl String?
  description String? @db.Text

  contactDiscoveryState CompanyContactDiscoveryEntryState @default(NOT_SEARCHED)
  communicationOptOut   Boolean   @default(false)
  communicationOptOutAt DateTime?
  firstPostCreatedAt    DateTime?
  emailBounced          Boolean   @default(false)
  lastEngagementEmailAt DateTime?
  engagementOptOutToken String? @unique
  profileCompletenessScore Int @default(0)

  websiteSource         CompanyWebsiteSource?
  websiteConfidence     Float?
  websiteVerifiedAt     DateTime?
  websiteManualOverride Boolean @default(false)

  discoveredEmail    String?
  emailSourceUrl     String?
  emailConfidence    Float?
  emailDiscoveredAt  DateTime?

  enrichmentStatus      CompanyEnrichmentStatus @default(DISCOVERY_PENDING)
  shortDescription      String? @db.Text
  enrichmentData        Json?
  contentEnrichedAt     DateTime?
  contentRefreshDueAt   DateTime?
  contentEnrichmentError String? @db.Text

  seoTitle                    String?
  seoDescription              String? @db.Text
  seoKeywords                 String[] @default([])
  seoQualityScore             Int @default(0)
  seoStatus                   CompanySeoStatus @default(SEO_NOT_READY)
  indexStatus                 CompanyIndexStatus @default(UNKNOWN)
  seoLastSignificantChangeAt  DateTime?
  previousSlugs               String[] @default([])
  seoDirty                    Boolean  @default(false)
  seoInputHash                String?

  socialIntroPublishedAt DateTime?
  socialIntroPostId      String?

  hidden      Boolean @default(false)
  inLiquidation Boolean @default(false)
  inactive    Boolean @default(false)
  dissolved   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimRequests          CompanyClaimRequest[]
  reports                CompanyProfileReport[]
  contactDiscoveryJobs   CompanyContactDiscoveryJob[]
  contacts               CompanyContact[]
  importItems            CompanyImportItem[]
  reviews                CompanyReview[]
  emailLogs              CompanyEmailLog[]
  posts                  Post[]
  googleEnrichmentItems  CompanyGoogleEnrichmentItem[]
  engagementEvents       CompanyEngagementEvent[]
  engagementCampaigns    CompanyEngagementCampaign[]
  leads                  CompanyLead[]
  emailQueueItems        CompanyEmailQueueItem[]
  contentEnrichmentJobs  CompanyContentEnrichmentJob[]
  socialPublishQueueItems CompanySocialPublishQueueItem[]
  seoPage                CompanySeoPage?

  @@index([publicProfile, profileStatus])
  @@index([communicationOptOut])
  @@index([contactDiscoveryState])
  @@index([region, city])
  @@index([verificationStatus])
  @@index([seoStatus, seoQualityScore])
  @@index([enrichmentStatus])
  @@index([hidden, inLiquidation, inactive, dissolved])
}

model CompanySeoPage {
  id               String              @id @default(cuid())
  companyId        String              @unique
  company          CompanyDirectoryEntry @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  metaDescription  String              @db.Text
  shortDescription String?             @db.Text
  longDescription  String?             @db.Text
  content          Json?
  seoScore         Int                 @default(0)
  status           CompanySeoPageStatus @default(PENDING)
  indexable        Boolean             @default(false)
  contentHash      String?
