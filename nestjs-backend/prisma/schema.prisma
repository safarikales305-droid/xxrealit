  subType         String   @default("")

  address         String   @default("")
  city            String

  area            Float?
  landArea        Float?
  floor           Int?
  totalFloors     Int?

  condition       String?
  construction    String?
  ownership       String?
  energyLabel     String?

  equipment       String?  @db.Text
  parking         Boolean  @default(false)
  cellar          Boolean  @default(false)

  images          String[] @default([])
  /// Hlavní fotka pro karty a OG (denormalizace).
