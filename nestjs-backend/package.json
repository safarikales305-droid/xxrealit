{
  "name": "nestjs-backend",
  "version": "0.0.1",
  "description": "NestJS backend with modular architecture",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "node scripts/prisma-cli.mjs generate && nest build && npm run playwright:install-chromium && node scripts/build-info.mjs && npm run verify:meta-oauth-scopes && npm run verify:meta-oauth-redirect-uri",
    "verify:meta-oauth-scopes": "tsx scripts/verify-meta-oauth-scopes.ts",
    "verify:meta-oauth-redirect-uri": "tsx scripts/verify-meta-oauth-redirect-uri.ts",
    "playwright:install-chromium": "node scripts/install-playwright-chromium.mjs",
    "test:uniqueness": "tsx --test src/common/account-uniqueness.constants.test.ts",
    "test:credit-debt": "tsx --test src/modules/credits/credit-debt.util.test.ts",
    "test:meta-v25-payload": "tsx --test src/modules/meta-center/meta-campaign-v25-payload.util.test.ts",
    "test:seo": "tsx --test src/modules/seo/*.test.ts",
    "test:openai": "tsx --test src/modules/openai/*.test.ts",
    "test:ai-chat": "tsx --test src/modules/ai-chat/*.test.ts",
    "test:meta-compare": "tsx --test src/modules/meta-center/meta-ads-manager-compare.util.test.ts",
    "seed:seo-locations": "tsx prisma/seed-seo-locations.ts",
    "sreality-prefill:save-storage": "tsx src/modules/properties/sreality-prefill.save-storage.ts",
    "start": "node dist/main.js",
    "start:prod": "sh -c 'sh prisma/scripts/migrate-deploy-safe.sh; node dist/main.js'",
    "start:dev": "nest start --watch",
    "postinstall": "node scripts/prisma-postinstall.mjs",
    "seed": "tsx prisma/seed.ts",
    "seed:all": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.19.0",
    "axios": "^1.8.4",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.9.0",
    "dotenv": "^17.3.1",
    "imapflow": "^1.0.186",
    "mailparser": "^3.7.2",
    "multer": "^2.1.1",
    "nodemailer": "^6.10.0",
    "openai": "^6.49.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "playwright": "^1.51.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.10.0",
    "rxjs": "^7.8.1",
    "sax": "^1.6.0",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7",
    "xml2js": "^0.6.2",
    "yauzl": "^3.4.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/sax": "^1.2.7",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "@types/xml2js": "^0.4.14",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^6.19.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
