# Local: SQLite (path relative to prisma/). Production (Railway + Neon): Postgres URL.
# DATABASE_URL="file:./dev.db"
# Railway → Variables: DATABASE_URL=PASTE_YOUR_NEON_DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Railway nastaví PORT automaticky — aplikace musí poslouchat process.env.PORT na 0.0.0.0
# PORT=3000

# CORS: produkční domény. Hlavní frontend je www.
FRONTEND_URL=https://www.xxrealit.cz
BACKEND_URL=https://surprising-wisdom-production-f679.up.railway.app
# CORS_ORIGINS=https://www.xxrealit.cz,https://xxrealit.cz

# Must match Next.js JWT_SECRET for cookie session verification
# JWT_SECRET=your-long-random-string

# Veřejná URL backendu (pro webhook URI v administraci; volitelné)
# API_PUBLIC_URL=https://surprising-wisdom-production-f679.up.railway.app

# --- Facebook Login (xxrealitpage) — registrace / přihlášení ---
# OAuth redirect: FRONTEND_URL + /api/auth/facebook/callback
FACEBOOK_LOGIN_APP_ID=1344354934496431
FACEBOOK_LOGIN_APP_SECRET=
# Zpětná kompatibilita (volitelné):
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_LOGIN_OAUTH_REDIRECT_URI=https://www.xxrealit.cz/api/auth/facebook/callback

# --- Facebook Pages / Marketing (testovací stránka xxrealit) ---
# Meta Centrum sdílí OAuth callback s portálem: FRONTEND_URL + /api/social/facebook/callback
FACEBOOK_PAGES_APP_ID=940467065697861
FACEBOOK_PAGES_APP_SECRET=
# FACEBOOK_OAUTH_CALLBACK_URI=https://www.xxrealit.cz/api/social/facebook/callback
# Page connect (profil / autopost): FRONTEND_URL + /api/social/facebook/page-callback

FACEBOOK_GRAPH_API_VERSION=v25.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_CONNECT_REQUIRES_REVIEW=false
SOCIAL_TOKEN_ENCRYPTION_KEY=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# Meta Centrum / katalog — volitelné (fallback po Meta Connect OAuth)
# FACEBOOK_BUSINESS_ID=
# FACEBOOK_CATALOG_ID=
# FACEBOOK_DATASET_ID=
# FACEBOOK_PIXEL_ID=
# FACEBOOK_CAPI_ACCESS_TOKEN=

# --- TikTok Content Posting API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://www.xxrealit.cz/api/tiktok/callback
TIKTOK_BASE_URL=https://open.tiktokapis.com

# --- WhatsApp Business Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
META_BUSINESS_ID=

# --- Web Push (PWA notifikace) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@xxrealit.cz
