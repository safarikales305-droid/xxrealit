# Local: SQLite (path relative to prisma/). Production (Railway + Neon): Postgres URL.
# DATABASE_URL="file:./dev.db"
# Railway → Variables: DATABASE_URL=PASTE_YOUR_NEON_DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Railway nastaví PORT automaticky — aplikace musí poslouchat process.env.PORT na 0.0.0.0
# Lokálně výchozí 3000:
# PORT=3000

# CORS: produkční domény. Hlavní frontend je www.
FRONTEND_URL=https://www.xxrealit.cz
# CORS_ORIGINS=https://www.xxrealit.cz,https://xxrealit.cz
# Další hlavičky pro preflight (volitelné): CORS_EXTRA_HEADERS=X-Custom-Header
# Prázdný shorts feed → 1 demo video: SHORTS_FEED_FALLBACK_DEMO=1 (jen dočasně)

# Must match Next.js JWT_SECRET for cookie session verification
# JWT_SECRET=your-long-random-string

# Veřejná URL backendu (pro webhook URI v administraci; volitelné pokud je redirect URI explicitní)
# API_PUBLIC_URL=https://api.xxrealit.cz

# --- Facebook Login (registrace / přihlášení) ---
# OAuth redirect se generuje z FRONTEND_URL → /api/social/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Volitelný override redirect URI (jinak FRONTEND_URL + /api/social/facebook/callback):
# FACEBOOK_CALLBACK_URL=https://www.xxrealit.cz/api/social/facebook/callback

# --- Facebook Pages API (propojení stránky + import příspěvků) ---
# OAuth redirect se generuje z FRONTEND_URL → /api/social/facebook/page-callback
FACEBOOK_PAGES_APP_ID=
FACEBOOK_PAGES_APP_SECRET=
# Volitelný override:
# FACEBOOK_PAGE_CONNECT_REDIRECT_URI=https://www.xxrealit.cz/api/social/facebook/page-callback
FACEBOOK_GRAPH_API_VERSION=v25.0
# Autoposting na stránku portálu (fallback pokud není v admin nastavení)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Výchozí true — pages scope fungují jen pro Meta Admin/Tester dokud není App Review
FACEBOOK_PAGE_CONNECT_REQUIRES_REVIEW=false
# Volitelně: čárkou oddělená Facebook User ID testerů (kromě ADMIN role v aplikaci)
# FACEBOOK_APP_TESTER_FACEBOOK_IDS=
SOCIAL_TOKEN_ENCRYPTION_KEY=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# --- TikTok Content Posting API (oficiální účet portálu) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://www.xxrealit.cz/api/tiktok/callback
TIKTOK_BASE_URL=https://open.tiktokapis.com

# --- WhatsApp Business Cloud API (volitelné — wa.me tlačítka fungují bez API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Meta Business ID (Business Manager) — není WABA ID
META_BUSINESS_ID=

# --- Web Push (PWA notifikace) ---
# Vygenerujte: npx web-push generate-vapid-keys
# Railway: VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT=mailto:admin@xxrealit.cz
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@xxrealit.cz

# REALITY_CZ_USERNAME=
# REALITY_CZ_PASSWORD=
# REALITY_CZ_TOTP_SECRET=
# REALITY_CZ_WSDL_URL=
