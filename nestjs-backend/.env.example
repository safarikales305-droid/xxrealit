# Local: SQLite (path relative to prisma/). Production (Railway + Neon): Postgres URL.
# DATABASE_URL="file:./dev.db"
# Railway → Variables: DATABASE_URL=PASTE_YOUR_NEON_DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Railway nastaví PORT automaticky — aplikace musí poslouchat process.env.PORT na 0.0.0.0
# PORT=3000

# CORS: produkční domény. Hlavní frontend je www.
FRONTEND_URL=https://www.xxrealit.cz
# Fallback OAuth callback, pokud není META_REDIRECT_URI (nikdy localhost v produkci)
BACKEND_URL=https://surprising-wisdom-production-f679.up.railway.app
# CORS_ORIGINS=https://www.xxrealit.cz,https://xxrealit.cz

# Must match Next.js JWT_SECRET for cookie session verification
# JWT_SECRET=your-long-random-string

# Veřejná URL backendu (pro webhook URI v administraci; volitelné)
# API_PUBLIC_URL=https://surprising-wisdom-production-f679.up.railway.app

# --- Facebook Login (xxrealitpage) — registrace / přihlášení ---
# Všechny Meta / Facebook OAuth toky používají jediný callback:
# https://www.xxrealit.cz/api/social/facebook/meta-connect-callback
FACEBOOK_LOGIN_APP_ID=1344354934496431
FACEBOOK_LOGIN_APP_SECRET=
# Zpětná kompatibilita (volitelné):
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# --- Facebook Pages / Marketing (testovací stránka xxrealit) ---
FACEBOOK_PAGES_APP_ID=940467065697861
FACEBOOK_PAGES_APP_SECRET=
# Jediná OAuth redirect URI (Login, Pages, Meta Centrum, autopost):
META_REDIRECT_URI=https://www.xxrealit.cz/api/social/facebook/meta-connect-callback
# Volitelný whitelist URI z Meta Developers (čárkou oddělené):
# META_ALLOWED_REDIRECT_URIS=https://www.xxrealit.cz/api/social/facebook/meta-connect-callback
# Legacy ENV (všechny mapují na META_REDIRECT_URI):
# FACEBOOK_LOGIN_OAUTH_REDIRECT_URI=https://www.xxrealit.cz/api/social/facebook/meta-connect-callback
# FACEBOOK_OAUTH_CALLBACK_URI=https://www.xxrealit.cz/api/social/facebook/meta-connect-callback
# FACEBOOK_PAGE_CONNECT_REDIRECT_URI=https://www.xxrealit.cz/api/social/facebook/meta-connect-callback
# Schválená OAuth scopes podle produktu (preferováno před META_APPROVED_OAUTH_SCOPES):
META_APPROVED_OAUTH_SCOPES_LOGIN=public_profile,email
META_APPROVED_OAUTH_SCOPES_PAGES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_metadata
META_APPROVED_OAUTH_SCOPES_CATALOG=business_management,catalog_management
META_APPROVED_OAUTH_SCOPES_INSTAGRAM=instagram_basic,instagram_manage_messages
META_APPROVED_OAUTH_SCOPES_MARKETING=ads_management,ads_read,business_management
# META_APPROVED_OAUTH_SCOPES_WHATSAPP=whatsapp_business_management,whatsapp_business_messaging
# Zpětná kompatibilita (fallback, pokud produktové ENV chybí):
# META_APPROVED_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_metadata,business_management,catalog_management

FACEBOOK_GRAPH_API_VERSION=v25.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_CONNECT_REQUIRES_REVIEW=false
SOCIAL_TOKEN_ENCRYPTION_KEY=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# Meta Centrum / katalog — volitelné (fallback po Meta Connect OAuth)
# FACEBOOK_BUSINESS_ID=
# FACEBOOK_CATALOG_ID=
# FACEBOOK_DATASET_ID=
# FACEBOOK_PIXEL_ID=
# FACEBOOK_CAPI_ACCESS_TOKEN=

# --- TikTok Content Posting API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://www.xxrealit.cz/api/tiktok/callback
TIKTOK_BASE_URL=https://open.tiktokapis.com

# --- WhatsApp Business Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
META_BUSINESS_ID=

# --- Meta tracking (Dataset má přednost před Pixel placeholderem) ---
META_DATASET_ID=
# META_PIXEL_ID=  # volitelný fallback; nepoužívejte placeholder SEM_VLOZ_PIXEL_ID
# META_AD_ACCOUNT_ID=  # volitelné — potřeba až pro spouštění kampaní

# --- Web Push (PWA notifikace) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@xxrealit.cz
